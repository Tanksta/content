[proc,rd_dismiss_macro_event]
if (%macro_event > 0) {
    if (npc_finduid(%macro_event_uid) = true) {
        ~macro_event_disappear;
    }
    ~macro_events_varps_reset;
}

[proc,rd_in_trial_area](coord $coord)(boolean)
def_int $map_x;
def_int $map_z;
$map_x, $map_z = ~mapsquare($coord);
if (%rd_main = ^recruitmentdrive_started & $map_x = 38 & $map_z = 77) {
    return(true);
}
return(false);

[proc,rd_local_x](coord $coord)(int)
def_int $y;
def_int $map_x;
def_int $map_z;
def_int $local_x;
def_int $local_z;
$y, $map_x, $map_z, $local_x, $local_z = ~coord_unpack($coord);
return($local_x);

[proc,rd_clear_trial_session_vars]
%rd_rooms_tempvar = 0;
%rd_rooms_tempvar2 = 0;
%rd_room_order = 0;
%rd_room2_missing_choice = 0;
~rd_reset_room6_item_varbits;
%rd_spoke_to_tiffy = 1;

