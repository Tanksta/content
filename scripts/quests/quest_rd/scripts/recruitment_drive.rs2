[oploc1,rd_portal_room5_entrance] @rd_quit_trials;
[oploc1,rd_portal_room6_entrance] @rd_quit_trials;
[oploc1,rd_portal_room7_entrance] @rd_quit_trials;

[oploc1,rd_portal_room1_exit] @rd_trial_exit(1);
[oploc1,rd_room1_exitdoor] @rd_trial_exit(1);
[oploc1,rd_portal_room2_exit] @rd_trial_exit(2);
[oploc1,rd_room2_exitdoor] @rd_trial_exit(2);
[oploc1,rd_portal_room3_exit] @rd_trial_exit(3);
[oploc1,rd_room3_exitdoor] @rd_trial_exit(3);
