[opnpc1,rd_observer_room_7]
if (%rd_room7_complete = 1) {
    ~chatnpc("<p,happy>The answer has already been accepted.");
    return;
}
def_int $riddle = ~rd_room7_riddle;
def_int $correct;
def_int $choice;
switch_int ($riddle) {
    case 1 :
        ~chatnpc("<p,neutral>Which statement is true: the number of false statements here is one, two, three, or four?");
        $correct = 3;
        $choice = ~p_choice4("One.", 1, "Two.", 2, "Three.", 3, "Four.", 4);
    case 2 :
        ~chatnpc("<p,neutral>My husband is four times older than my daughter. In twenty years he will be twice her age. How old is she now?");
        $correct = 2;
        $choice = ~p_choice4("Five.", 1, "Ten.", 2, "Fifteen.", 3, "Twenty.", 4);
    case 3 :
        ~chatnpc("<p,neutral>You must choose a death: acid, fire, unfed wolves, or a fall from castle walls.");
        $correct = 3;
        $choice = ~p_choice4("The acid.", 1, "The fire.", 2, "The unfed wolves.", 3, "The fall.", 4);
    case 4 :
        ~chatnpc("<p,neutral>Four stones are dropped into buckets at 32, 33, 34 and 35 degrees Fahrenheit. Which stone reaches the bottom last?");
        $correct = 1;
        $choice = ~p_choice4("The 32 degree bucket.", 1, "The 33 degree bucket.", 2, "The 34 degree bucket.", 3, "The 35 degree bucket.", 4);
    case 5 :
        ~chatnpc("<p,neutral>If the fingers on every left hand in RuneScape were multiplied by zero, what number would you get?");
        $correct = 4;
        $choice = ~p_choice4("One.", 1, "One million.", 2, "Ten million.", 3, "Zero.", 4);
}
if ($choice = $correct) {
    ~chatplayer("<p,neutral>That is my answer.");
    ~chatnpc("<p,happy>Correct. Logic, not guesswork.");
    ~rd_room_complete(7);
    mes("The final door unlocks.");
} else {
    @rd_fail_trial("That answer contradicts the riddle. The trial resets.");
}

[proc,rd_room7_riddle]()(int)
if (%rd_templock_2 < 1 | %rd_templock_2 > 5) {
    %rd_templock_2 = add(random(5), 1);
}
return (%rd_templock_2);

[oploc1,rd_room2_fox_multi] @rd_room2_pickup(1, rd_fox);
[oploc1,rd_room2_fox_multi_right] @rd_room2_pickup(2, rd_fox);
[oploc1,rd_room2_chicken_multi] @rd_room2_pickup(1, rd_chicken);
[oploc1,rd_room2_chicken_multi_right] @rd_room2_pickup(2, rd_chicken);
[oploc1,rd_room2_grain_multi] @rd_room2_pickup(1, rd_sack);
[oploc1,rd_room2_grain_multi_right] @rd_room2_pickup(2, rd_sack);

[label,rd_room2_pickup](int $side, obj $item)
if (%rd_room1_complete = 1) {
    mes("The trial has already been solved.");
    return;
}
if (inv_getobj(worn, oc_wearpos($item)) ! null) {
    mes("You need both hands and your back free for this test.");
    return;
}
if (~rd_room2_can_carry($item) = false) {
    return;
}
if ($side = 1) {
    if ($item = rd_fox & %rd_foxleft = 0) { %rd_foxleft = 1; ~rd_room2_carry(rd_fox); mes("You pick up the fox."); return; }
    if ($item = rd_chicken & %rd_chickleft = 0) { %rd_chickleft = 1; ~rd_room2_carry(rd_chicken); mes("You pick up the chicken."); return; }
    if ($item = rd_sack & %rd_grainleft = 0) { %rd_grainleft = 1; ~rd_room2_carry(rd_sack); mes("You pick up the grain."); return; }
} else {
    if ($item = rd_fox & %rd_foxright = 1) { %rd_foxright = 0; ~rd_room2_carry(rd_fox); mes("You pick up the fox."); return; }
    if ($item = rd_chicken & %rd_chickright = 1) { %rd_chickright = 0; ~rd_room2_carry(rd_chicken); mes("You pick up the chicken."); return; }
    if ($item = rd_sack & %rd_grainright = 1) { %rd_grainright = 0; ~rd_room2_carry(rd_sack); mes("You pick up the grain."); return; }
}
mes("There is nothing there to pick up.");

[proc,rd_room2_can_carry](obj $item)(boolean)
def_int $carried_count = ~rd_carried_count;
if ($carried_count = 0) {
    return(true);
}
if ($item = rd_sack | inv_total(worn, rd_sack) > 0 | inv_total(inv, rd_sack) > 0) {
    mes("You can only carry the grain by itself.");
    return(false);
}
if ($carried_count = 1) {
    if ($item = rd_fox & (inv_total(worn, rd_chicken) > 0 | inv_total(inv, rd_chicken) > 0)) {
        return(true);
    }
    if ($item = rd_chicken & (inv_total(worn, rd_fox) > 0 | inv_total(inv, rd_fox) > 0)) {
        return(true);
    }
}
mes("You can only carry the fox and chicken together.");
return(false);

[proc,rd_room2_carry](namedobj $item)
inv_setslot(worn, oc_wearpos($item), $item, 1);
~update_all(null);

[proc,rd_room2_carried_item]()(obj)
if (inv_total(inv, rd_fox) > 0 | inv_total(worn, rd_fox) > 0) { return(rd_fox); }
if (inv_total(inv, rd_chicken) > 0 | inv_total(worn, rd_chicken) > 0) { return(rd_chicken); }
if (inv_total(inv, rd_sack) > 0 | inv_total(worn, rd_sack) > 0) { return(rd_sack); }
return(null);

[proc,rd_carried_count]()(int)
return (calc(inv_total(inv, rd_fox) + inv_total(inv, rd_chicken) + inv_total(inv, rd_sack) + inv_total(worn, rd_fox) + inv_total(worn, rd_chicken) + inv_total(worn, rd_sack)));

[oploc1,rd_bridge_left] @rd_room2_cross;
[oploc1,rd_bridge_right] @rd_room2_cross;

[label,rd_room2_cross]
if (~rd_room2_can_cross = false) {
    mes("The bridge will only support the fox and chicken together.");
    return;
}
if (~rd_room2_on_east_side(coord) = true) {
    ~rd_room2_bridge_walk(0_38_77_44_44);
    if (~rd_room2_bad_left = true) { @rd_fail_trial("Something has eaten something else. The trial resets."); return; }
} else {
    ~rd_room2_bridge_walk(0_38_77_52_44);
    if (~rd_room2_bad_right = true) { @rd_fail_trial("Something has eaten something else. The trial resets."); return; }
}
~rd_room2_check_complete;

[proc,rd_room2_can_cross]()(boolean)
def_int $carried_count = ~rd_carried_count;
if ($carried_count < 2) {
    return(true);
}
if ($carried_count = 2 & (inv_total(worn, rd_fox) > 0 | inv_total(inv, rd_fox) > 0) & (inv_total(worn, rd_chicken) > 0 | inv_total(inv, rd_chicken) > 0) & inv_total(worn, rd_sack) = 0 & inv_total(inv, rd_sack) = 0) {
    return(true);
}
return(false);

[proc,rd_room2_bridge_walk](coord $dest)
p_arrivedelay;
p_walk($dest);
p_delay(calc(distance(coord, $dest) + 1));

[proc,rd_room2_on_east_side](coord $check)(boolean)
if (distance($check, 0_38_77_54_46) <= distance($check, 0_38_77_42_42)) {
    return(true);
}
return(false);

[proc,rd_room2_check_complete]
if (%rd_room1_complete = 0 & %rd_foxright = 1 & %rd_chickright = 1 & %rd_grainright = 1 & ~rd_carried_count = 0) {
    ~rd_room_complete(1);
    mes("The fox, chicken and grain are safely across.");
}

[proc,rd_room2_is_carry_item](obj $item)(boolean)
if ($item = rd_fox | $item = rd_chicken | $item = rd_sack) {
    return(true);
}
return(false);

[proc,rd_room2_return_carried](obj $item)(boolean)
if (~rd_room2_is_carry_item($item) = false) {
    return(false);
}
inv_del(worn, $item, ^max_32bit_int);
if (%rd_main = ^recruitmentdrive_started & inzone(0_38_77_38_40, 0_38_77_58_49, coord) = true) {
    if (~rd_room2_on_east_side(coord) = true) {
        ~rd_room2_mark_left($item);
    } else {
        ~rd_room2_mark_right($item);
    }
}
~update_all($item);
mes("You put down the <lowercase(oc_name($item))>.");
~rd_room2_check_complete;
return(true);

[proc,rd_room2_mark_left](obj $item)
if ($item = rd_fox) { %rd_foxleft = 0; }
if ($item = rd_chicken) { %rd_chickleft = 0; }
if ($item = rd_sack) { %rd_grainleft = 0; }

[proc,rd_room2_mark_right](obj $item)
if ($item = rd_fox) { %rd_foxright = 1; }
if ($item = rd_chicken) { %rd_chickright = 1; }
if ($item = rd_sack) { %rd_grainright = 1; }

[label,rd_room2_place_right]
def_obj $carried = ~rd_room2_carried_item;
if (inv_total(inv, rd_fox) > 0 | inv_total(worn, rd_fox) > 0) { ~rd_del_all(rd_fox); %rd_foxright = 1; }
if (inv_total(inv, rd_chicken) > 0 | inv_total(worn, rd_chicken) > 0) { ~rd_del_all(rd_chicken); %rd_chickright = 1; }
if (inv_total(inv, rd_sack) > 0 | inv_total(worn, rd_sack) > 0) { ~rd_del_all(rd_sack); %rd_grainright = 1; }
if ($carried ! null) { ~update_all($carried); }

[label,rd_room2_place_left]
def_obj $carried = ~rd_room2_carried_item;
if (inv_total(inv, rd_fox) > 0 | inv_total(worn, rd_fox) > 0) { ~rd_del_all(rd_fox); %rd_foxleft = 0; }
if (inv_total(inv, rd_chicken) > 0 | inv_total(worn, rd_chicken) > 0) { ~rd_del_all(rd_chicken); %rd_chickleft = 0; }
if (inv_total(inv, rd_sack) > 0 | inv_total(worn, rd_sack) > 0) { ~rd_del_all(rd_sack); %rd_grainleft = 0; }
if ($carried ! null) { ~update_all($carried); }

[proc,rd_room2_bad_left]()(boolean)
if (%rd_room1_complete = 1) { return (false); }
if (%rd_foxleft = 0 & %rd_chickleft = 0 & %rd_grainleft ! 0) { return (true); }
return (false);

[proc,rd_room2_bad_right]()(boolean)
if (%rd_room1_complete = 1) { return (false); }
if (%rd_foxright = 1 & %rd_chickright = 1 & %rd_grainright ! 1) { return (true); }
return (false);

[proc,rd_complete_quest]
~rd_cleanup_trial_npcs;
~rd_clear_room_items;
%rd_main = ^recruitmentdrive_complete;
p_telejump(0_46_52_53_44);
~give_quest_xp(prayer, 10000);
~give_quest_xp(herblore, 10000);
~give_quest_xp(agility, 10000);
inv_add(inv, coins, 3000);
inv_add(inv, basic_tk_helm, 1);
if (%rd_male_at_start = 1) {
    inv_add(inv, rd_makeover_ticket, 1);
}
session_log(^log_adventure, "Quest complete: Recruitment Drive");
~chatnpc_specific("Sir Tiffy Cashien", rd_teleporter_guy, "<p,happy>Oh, jolly well done! Welcome to the Temple Knights, Initiate.");
~send_quest_complete(questlist:rd, basic_tk_helm, 250, ^recruitmentdrive_questpoints, "You have passed the\\nRecruitment Drive!");
