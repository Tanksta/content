[proc,rd_cleanup_trial_npcs]
npc_findallany(0_38_77_32_32, 64, ^vis_off);
while (npc_findnext = true) {
    switch_npc(npc_type) {
        case rd_combat_npc_room_3 :
            npc_del;
    }
}

[proc,rd_logout]
if (~rd_in_trial_area(coord) = false) {
    return;
}
~rd_cleanup_trial_npcs;
~rd_clear_room_items;
~rd_clear_trial_session_vars;
p_telejump(0_46_52_53_44);

[proc,rd_completed_count]()(int)
def_int $count = 0;
if (%rd_room1_complete = 1) { $count = add($count, 1); }
if (%rd_room2_complete = 1) { $count = add($count, 1); }
if (%rd_room3_complete = 1) { $count = add($count, 1); }
if (%rd_room4_complete = 1) { $count = add($count, 1); }
if (%rd_room5_complete = 1) { $count = add($count, 1); }
if (%rd_room6_complete = 1) { $count = add($count, 1); }
if (%rd_room7_complete = 1) { $count = add($count, 1); }
return ($count);

[proc,rd_room_is_complete](int $room)(boolean)
switch_int ($room) {
    case 1 : if (%rd_room1_complete = 1) { return (true); } return (false);
    case 2 : if (%rd_room2_complete = 1) { return (true); } return (false);
    case 3 : if (%rd_room3_complete = 1) { return (true); } return (false);
    case 4 : if (%rd_room4_complete = 1) { return (true); } return (false);
    case 5 : if (%rd_room5_complete = 1) { return (true); } return (false);
    case 6 : if (%rd_room6_complete = 1) { return (true); } return (false);
    case 7 : if (%rd_room7_complete = 1) { return (true); } return (false);
}
return (true);

[proc,rd_next_trial]()(int)
def_int $complete = ~rd_completed_count;
if ($complete >= 5 & %rd_room3_complete = 1) {
    return (8);
}
if ($complete >= 4 & %rd_room3_complete = 0) {
    return (3);
}

def_int $tries = 0;
def_int $room;
while ($tries < 16) {
    $room = add(random(7), 1);
    if (~rd_room_is_complete($room) = false) {
        return ($room);
    }
    $tries = add($tries, 1);
}
if (%rd_room1_complete = 0) { return (1); }
if (%rd_room2_complete = 0) { return (2); }
if (%rd_room3_complete = 0) { return (3); }
if (%rd_room4_complete = 0) { return (4); }
if (%rd_room5_complete = 0) { return (5); }
if (%rd_room6_complete = 0) { return (6); }
if (%rd_room7_complete = 0) { return (7); }
return (8);

[proc,rd_trial_coord](int $room)(coord)
switch_int ($room) {
    case 1 : return (0_38_77_56_45);
    case 2 : return (0_38_77_26_53);
    case 3 : return (0_38_77_25_38);
    case 4 : return (0_38_77_44_30);
    case 5 : return (0_38_77_10_28);
    case 6 : return (0_38_77_37_13);
    case 7 : return (0_38_77_20_11);
}
return (0_46_52_53_44);

[proc,rd_room_complete](int $room)
switch_int ($room) {
    case 1 : %rd_room1_complete = 1;
    case 2 : %rd_room2_complete = 1;
    case 3 : %rd_room3_complete = 1;
    case 4 : %rd_room4_complete = 1;
    case 5 : %rd_room5_complete = 1;
    case 6 : %rd_room6_complete = 1;
    case 7 : %rd_room7_complete = 1;
}
~rd_clear_room_items;

[proc,rd_enter_next_trial]
def_int $room = ~rd_next_trial;
if ($room >= 8) {
    ~rd_complete_quest;
    return;
}
p_telejump(~rd_trial_coord($room));
if ($room = 2) {
    ~rd_room2_intro;
}

[label,rd_trial_exit](int $room)
switch_int ($room) {
    case 1 : if (%rd_room1_complete = 0) { mes("The door refuses to open until the trial is complete."); return; }
    case 2 : if (%rd_room2_complete = 0) { mes("The door refuses to open until the trial is complete."); return; }
    case 3 : if (%rd_room3_complete = 0) { mes("The door refuses to open until the trial is complete."); return; }
    case 4 : if (%rd_room4_complete = 0) { mes("The door refuses to open until the trial is complete."); return; }
    case 5 : if (%rd_room5_complete = 0) { mes("The door refuses to open until the trial is complete."); return; }
    case 6 : if (%rd_room6_complete = 0) { mes("The door refuses to open until the trial is complete."); return; }
    case 7 : if (%rd_room7_complete = 0) { mes("The door refuses to open until the trial is complete."); return; }
}
~rd_enter_next_trial;

[label,rd_quit_trials]
~chatnpc_specific("Sir Tiffy Cashien", rd_teleporter_guy, "<p,sad>Jolly bad luck, what? Come back when you fancy another attempt.");
~rd_cleanup_trial_npcs;
~rd_reset_trial_vars;
p_telejump(0_46_52_53_44);

[label,rd_fail_trial](string $reason)
mes($reason);
~rd_cleanup_trial_npcs;
~rd_reset_trial_vars;
p_telejump(0_46_52_53_44);

[oploc1,rd_portal_room1_entrance] @rd_quit_trials;
[oploc1,rd_portal_room2_entrance] @rd_quit_trials;
