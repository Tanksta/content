[oploc1,rd_room4_exitdoor] @rd_trial_exit(4);
[oploc1,rd_portal_room5_exit] @rd_trial_exit(5);
[oploc1,rd_room5_exitdoor] @rd_trial_exit(5);
[oploc1,rd_portal_room6_exit] @rd_trial_exit(6);
[oploc1,rd_room6_exitdoor] @rd_trial_exit(6);
[oploc1,rd_portal_room7_exit] @rd_trial_exit(7);
[oploc1,rd_room7_exitdoor] @rd_trial_exit(7);

[opnpc1,rd_observer_room_1]
if (%rd_room1_complete = 1) {
    ~chatnpc("<p,happy>Well done. The exit portal is open.");
    return;
}
if (%rd_room1_intro_chat = 1) {
    ~chatnpc("<p,neutral>Remember: bring the fox, chicken and grain safely to the far side.");
    return;
}
%rd_room1_intro_chat = 1;
~chatnpc("<p,neutral>Your task is to take the fox, chicken and grain across the bridge.");
~chatnpc("<p,neutral>You may carry the fox and chicken together if you have to, but never leave them alone together.");
~chatnpc("<p,neutral>Bring all three safely to the far side.");

[opnpc1,rd_observer_room_2]
if (%rd_room2_complete = 1) {
    ~chatnpc("<p,happy>You have already solved my test.");
    return;
}
if (%rd_room2_missing_choice = 0) {
    ~rd_room2_intro;
    return;
}
~chatnpc("<p,neutral>Remember the missing statue from when you entered. Four weapons, three metals. Touch the one that was absent.");

[proc,rd_room2_intro]
if (%rd_room2_complete = 1) {
    return;
}
%rd_room2_missing_choice = add(random(12), 1);
%rd_room_order = %rd_room2_missing_choice;
queue(rd_room2_reveal_statues_queue, 4, 0);
~chatnpc_specific("Lady Table", rd_observer_room_2, "<p,neutral>Observe the statues carefully. Four weapons, three metals. One of them is missing.");
~chatnpc_specific("Lady Table", rd_observer_room_2, "<p,neutral>When the room changes, all the statues will return. Touch the statue that was missing before.");
p_delay(3);
~rd_room2_reveal_statues;

[queue,rd_room2_reveal_statues_queue]
~rd_room2_reveal_statues;

[proc,rd_room2_reveal_statues]
if (%rd_room2_complete = 0 & %rd_main = ^recruitmentdrive_started) {
    %rd_room_order = 0;
}

[oploc1,rd_statue_multi_1] @rd_statue_choice(1);
[oploc1,rd_statue_multi_2] @rd_statue_choice(2);
[oploc1,rd_statue_multi_3] @rd_statue_choice(3);
[oploc1,rd_statue_multi_4] @rd_statue_choice(4);
[oploc1,rd_statue_multi_5] @rd_statue_choice(5);
[oploc1,rd_statue_multi_6] @rd_statue_choice(6);
[oploc1,rd_statue_multi_7] @rd_statue_choice(7);
[oploc1,rd_statue_multi_8] @rd_statue_choice(8);
[oploc1,rd_statue_multi_9] @rd_statue_choice(9);
[oploc1,rd_statue_multi_10] @rd_statue_choice(10);
[oploc1,rd_statue_multi_11] @rd_statue_choice(11);
[oploc1,rd_statue_multi_12] @rd_statue_choice(12);

[label,rd_statue_choice](int $choice)
if (%rd_room2_missing_choice < 1 | %rd_room2_missing_choice > 12) {
    mes("You need to observe the room first.");
    return;
}
if (%rd_room_order ! 0) {
    mes("You need to wait for all the statues to return first.");
    return;
}
def_int $answer = ~rd_statue_answer;
if ($choice = $answer) {
    mes("You touch the statue that was missing from the set.");
    ~rd_room_complete(2);
    mes("Lady Table unlocks the exit.");
} else {
    @rd_fail_trial("That is not the missing statue. The trial resets.");
}

[proc,rd_statue_answer]()(int)
switch_int (%rd_room2_missing_choice) {
    case 1 : return (6);
    case 2 : return (5);
    case 3 : return (4);
    case 4 : return (3);
    case 5 : return (2);
    case 6 : return (1);
    case 7 : return (10);
    case 8 : return (11);
    case 9 : return (12);
    case 10 : return (9);
    case 11 : return (8);
    case 12 : return (7);
}
return (0);

[opnpc1,rd_observer_room_3]
if (%rd_room3_complete = 1) {
    ~chatnpc("<p,happy>Sir Leye has been defeated. Use the exit portal.");
    return;
}
~chatnpc("<p,neutral>Sir Leye is blessed by Saradomin, so no man may defeat him. A woman can only best him in combat.");
if (gender() = 0) {
    ~chatnpc("<p,neutral>You may need the Make-over Mage before you can pass this room.");
} else {
    if_close;
    queue(rd_leye_start_fight_queue, 1, 0);
}

[queue,rd_leye_start_fight_queue]
if (%rd_main = ^recruitmentdrive_started & %rd_room3_complete = 0) {
    @rd_leye_start_fight;
}

[label,rd_leye_start_fight]
if (npc_find(0_38_77_27_36, rd_combat_npc_room_3, 12, 0) = false) {
    npc_add(0_38_77_27_36, rd_combat_npc_room_3, 500);
}
%npc_aggressive_player = uid;
%npc_attacking_uid = uid;
%npc_lastcombat = map_clock;
hint_npc;
npc_setmode(opplayer2);

[opnpc2,rd_combat_npc_room_3] @rd_leye_player_attack;
[apnpc2,rd_combat_npc_room_3] @rd_leye_player_attack_ap;

[label,rd_leye_player_attack_ap]
if (gender() = 0) {
    mes("Sir Leye's blessing prevents any man from defeating him.");
    return;
}
@player_combat_start_ap;

[label,rd_leye_player_attack]
if (gender() = 0) {
    mes("Sir Leye's blessing prevents any man from defeating him.");
    return;
}
@player_combat_start;

[opnpc1,rd_combat_npc_room_3]
~chatnpc("<p,angry>No man alive may defeat me.");
if (gender() = 0) {
    ~chatplayer("<p,neutral>That sounds inconvenient.");
} else {
    ~chatplayer("<p,angry>Then defend yourself.");
}

[ai_queue2,rd_combat_npc_room_3]
if (npc_findhero = ^true & gender() = 0) {
    npc_damage(^hitmark_block, 0);
    return;
}
~npc_default_damage(last_int);

[ai_queue3,rd_combat_npc_room_3]
gosub(npc_death);
if (npc_findhero = ^true) {
    if_close;
    if (p_finduid(uid) = true) {
        @rd_leye_defeated;
        return;
    }
    queue(rd_leye_defeated_queue, 0, 0);
}

[queue,rd_leye_defeated_queue] @rd_leye_defeated;

[label,rd_leye_defeated]
hint_stop;
if (%rd_main ! ^recruitmentdrive_started | %rd_room3_complete = 1) {
    return;
}
if (gender() = 0) {
    @rd_fail_trial("Sir Leye's blessing prevents you from completing the trial as a man.");
    return;
}
%rd_room3_complete = 1;
mes("Sir Leye has been defeated. The exit is unlocked.");

[proc,rd_leye_valid_finishing_weapon]()(boolean)
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
if ($weapon = null | $weapon = steel_warhammer) {
    return(true);
}
return(false);

[opnpc1,rd_observer_room_4]
if (%rd_room4_complete = 1) {
    ~chatnpc("<p,happy>You have waited long enough. Use the exit.");
    return;
}
~chatnpc("<p,neutral>This test is simple: patience. Do nothing until I tell you to move.");
def_coord $start = coord;
if_close;
p_delay(8);
if (coord ! $start) {
    @rd_fail_trial("You moved before Sir Tinley told you to. The trial resets.");
    return;
}
