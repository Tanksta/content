[opnpc1,rd_observer_room_5]
if (%rd_room5_complete = 1) {
    ~chatnpc("<p,happy>The lock is already open.");
    return;
}
~chatnpc("<p,neutral>Each line gives you a first letter. Four letters make the answer.");
def_int $riddle = ~rd_room5_riddle;
def_int $correct;
def_int $choice;
switch_int ($riddle) {
    case 1 :
        ~chatnpc("<p,neutral>Find my answer in the first breath.|Inside each line a letter waits.|Seek those starts, then speak them here.|Hear the door accept your word.");
        $correct = 1;
        $choice = ~p_choice4("FISH", 1, "RAIN", 2, "BITE", 3, "TIME", 4);
    case 2 :
        ~chatnpc("<p,neutral>Begin with every opening sound.|In the lines the answer hides.|Trust the first of each phrase.|Enter that word to pass.");
        $correct = 2;
        $choice = ~p_choice4("FISH", 1, "BITE", 2, "PASS", 3, "CLUE", 4);
    case 3 :
        ~chatnpc("<p,neutral>Read the first marks carefully.|Answers are often left in sight.|In each line one letter leads.|Name the word those leaders form.");
        $correct = 3;
        $choice = ~p_choice4("MEAT", 1, "TIME", 2, "RAIN", 3, "LAST", 4);
    case 4 :
        ~chatnpc("<p,neutral>Look to the start of every line.|A hidden answer waits there.|Study them together.|Tell what they spell.");
        $correct = 4;
        $choice = ~p_choice4("PASS", 1, "CLUE", 2, "MEAT", 3, "LAST", 4);
    case 5 :
        ~chatnpc("<p,neutral>Many clues can hide in words.|Every answer starts a line.|All initials form the key.|Tell me what they spell.");
        $correct = 4;
        $choice = ~p_choice4("RAIN", 1, "TIME", 2, "FISH", 3, "MEAT", 4);
    case 6 :
        ~chatnpc("<p,neutral>The first thing said is what matters.|In every line a letter begins.|Mark them in order.|Enter the word they make.");
        $correct = 2;
        $choice = ~p_choice4("RAIN", 1, "TIME", 2, "BITE", 3, "MEAT", 4);
}
if ($choice = $correct) {
    ~chatplayer("<p,neutral>That should be the answer.");
    ~chatnpc("<p,happy>Correct. The combination lock clicks open.");
    ~rd_room_complete(5);
} else {
    @rd_fail_trial("The lock refuses that answer. The trial resets.");
}

