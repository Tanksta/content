[opnpc1,rd_teleporter_guy]
if (%rd_main = ^recruitmentdrive_complete) {
    @rd_tiffy_afterquest;
    return;
}
if (%rd_main = ^recruitmentdrive_not_started) {
    @rd_tiffy_needs_amik;
    return;
}
if (%rd_spoke_to_tiffy = 1 | ~rd_completed_count > 0) {
    @rd_tiffy_resume;
    return;
}
@rd_tiffy_start;

[proc,rd_tiffy_open_initiate_shop]
~openshop(rd_initiate_shop, 500, 1000, 0, "Initiate Temple Knight Armoury");

[label,rd_tiffy_needs_amik]
~chatplayer("<p,neutral>Hello. Are you Sir Tiffy Cashien?");
~chatnpc("<p,happy>What ho! Sir Tiffy Cashien at your service, old bean.");
~chatnpc("<p,neutral>I handle recruitment for the Temple Knights, but candidates need Sir Amik Varze's recommendation first.");
~chatnpc("<p,neutral>Have a word with Sir Amik in Falador Castle, then come back and we'll see about your test.");

[label,rd_tiffy_start]
~chatplayer("<p,neutral>Hello. Are you Sir Tiffy Cashien?");
~chatnpc("<p,happy>What ho! Sir Amik told me to expect you, dontchaknow. A promising candidate for the Temple Knights.");
if (%qp < 12) {
    ~chatnpc("<p,neutral>Sadly, we only test adventurers who have already made a name for themselves.");
    mes("You need at least 12 quest points before you may start Recruitment Drive.");
    return;
}
if (%spy < ^blackknight_complete) {
    ~chatnpc("<p,neutral>Sir Amik's recommendation is rather important. Help him with the Black Knights first, then come back to me.");
    return;
}
if (%druidquest < ^druid_complete) {
    ~chatnpc("<p,neutral>The order requires a basic knowledge of Herblore. Finish Druidic Ritual and then we can talk.");
    return;
}
def_int $choice = ~p_choice3("Testing?", 1, "Tell me about the Temple Knights.", 2, "Yes, let's go!", 3);
if ($choice = 1) {
    ~chatplayer("<p,quiz>Testing? What exactly do you mean?");
    ~chatnpc("<p,neutral>Not brute force, old bean. We have enough people who can swing swords. The order needs wit, judgement and nerve.");
    ~chatnpc("<p,neutral>You will pass through a series of sealed rooms. Each one is self-contained; bring no equipment and no items.");
    ~chatnpc("<p,neutral>You may quit at any time through the entrance portal, but doing so clears your trial progress.");
    $choice = ~p_choice2("I'm ready.", 1, "I'll prepare first.", 2);
    if ($choice = 2) {
        ~chatplayer("<p,neutral>I'll prepare first.");
        return;
    }
} else if ($choice = 2) {
    ~chatplayer("<p,quiz>Tell me about the Temple Knights.");
    ~chatnpc("<p,neutral>We are Saradomin's premier order of knights, shrouded in secrecy and trusted with problems too delicate for ordinary soldiers.");
    ~chatnpc("<p,happy>Only the sharpest recruits are invited. That is where your puzzle rooms come in, what?");
    $choice = ~p_choice2("I'm ready.", 1, "I'll prepare first.", 2);
    if ($choice = 2) {
        ~chatplayer("<p,neutral>I'll prepare first.");
        return;
    }
} else {
    ~chatplayer("<p,happy>Yes, let's go!");
}
@rd_begin_testing;

[label,rd_tiffy_resume]
~chatnpc("<p,happy>Back for another crack at the old testing rooms, what?");
def_int $choice = ~p_choice2("Yes, send me back.", 1, "No, not yet.", 2);
if ($choice = 2) {
    ~chatplayer("<p,neutral>No, not yet.");
    return;
}
@rd_resume_testing;

[label,rd_begin_testing]
if (inv_freespace(inv) ! inv_size(inv) | inv_freespace(worn) ! inv_size(worn)) {
    ~chatnpc("<p,neutral>Standard puzzle room rules, old bean: empty hands, empty pack, empty pockets. Bank everything first.");
    return;
}
~rd_dismiss_macro_event;
~rd_reset_trial_vars;
%rd_spoke_to_tiffy = 1;
if (gender() = 0) {
    %rd_male_at_start = 1;
} else {
    %rd_male_at_start = 0;
}
~chatnpc("<p,happy>Jolly good show! Mind your head... ignore the smell... and here we are.");
~rd_enter_next_trial;

[label,rd_resume_testing]
if (inv_freespace(inv) ! inv_size(inv) | inv_freespace(worn) ! inv_size(worn)) {
    ~chatnpc("<p,neutral>Standard puzzle room rules, old bean: empty hands, empty pack, empty pockets. Bank everything first.");
    return;
}
~rd_dismiss_macro_event;
%rd_spoke_to_tiffy = 1;
~send_quest_progress(questlist:rd, %rd_main, ^recruitmentdrive_complete);
~chatnpc("<p,happy>Right-o. I'll send you back to your next unfinished test.");
~rd_enter_next_trial;

[label,rd_tiffy_afterquest]
~chatnpc("<p,happy>Good day Initiate. Is there anything I can do for you?");
@rd_tiffy_afterquest_options;

[label,rd_tiffy_afterquest_options]
def_int $choice = ~p_choice3("Do you have any jobs for me yet?", 1, "Can I buy some armour?", 2, "Goodbye.", 3);
if ($choice = 1) {
    ~chatplayer("<p,quiz>Do you have any jobs for me yet?");
    ~chatnpc("<p,neutral>Sorry old bean, but we are still getting things organised.");
    ~chatnpc("<p,happy>I'm sure we will have something for you soon. Anything else I can do in the meantime?");
    @rd_tiffy_afterquest_options;
} else if ($choice = 2) {
    ~chatplayer("<p,neutral>Can I buy some armour?");
    ~chatnpc("<p,happy>Of course old bean. Initiate armour is available to members of the order.");
    ~rd_tiffy_open_initiate_shop;
} else {
    ~chatplayer("<p,neutral>Well, see you around Tiffy.");
    ~chatnpc("<p,happy>Ta-ta for now, old bean!");
}

