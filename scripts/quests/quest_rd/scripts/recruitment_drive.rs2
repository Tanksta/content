[opheldu,rd_full_keymould_copper] @rd_powder_use(rd_full_keymould_copper, last_useitem);

[label,rd_powder_use](obj $target, obj $used)
if (inv_total(inv, rd_keymould) > 0 & ($target = rd_tin_ore_powder | $used = rd_tin_ore_powder) & inv_total(inv, rd_tin_ore_powder) > 0) {
    inv_del(inv, rd_keymould, 1);
    inv_del(inv, rd_tin_ore_powder, 1);
    inv_add(inv, rd_full_keymould_tin, 1);
    mes("You add the tin ore powder to the key mould.");
} else if (inv_total(inv, rd_keymould) > 0 & ($target = rd_copper_ore_powder | $used = rd_copper_ore_powder) & inv_total(inv, rd_copper_ore_powder) > 0) {
    inv_del(inv, rd_keymould, 1);
    inv_del(inv, rd_copper_ore_powder, 1);
    inv_add(inv, rd_full_keymould_copper, 1);
    mes("You add the cupric ore powder to the key mould.");
} else if (inv_total(inv, rd_full_keymould_tin) > 0 & ($target = rd_copper_ore_powder | $used = rd_copper_ore_powder) & inv_total(inv, rd_copper_ore_powder) > 0) {
    inv_del(inv, rd_full_keymould_tin, 1);
    inv_del(inv, rd_copper_ore_powder, 1);
    inv_add(inv, rd_full_keymould_unheated, 1);
    mes("You add the cupric ore powder to the tin-filled mould.");
} else if (inv_total(inv, rd_full_keymould_copper) > 0 & ($target = rd_tin_ore_powder | $used = rd_tin_ore_powder) & inv_total(inv, rd_tin_ore_powder) > 0) {
    inv_del(inv, rd_full_keymould_copper, 1);
    inv_del(inv, rd_tin_ore_powder, 1);
    inv_add(inv, rd_full_keymould_unheated, 1);
    mes("You add the tin ore powder to the cupric-filled mould.");
} else {
    ~displaymessage(^dm_default);
}

