inv_del(inv, rd_gypsum, 1);
inv_add(inv, rd_tinfull, 1);
%rd_gypsum_in_tin = 1;
mes("You make a white lumpy mixture in the tin.");

[opheldu,rd_keymould] @rd_powder_use(rd_keymould, last_useitem);
[opheldu,rd_tin_ore_powder] @rd_powder_use(rd_tin_ore_powder, last_useitem);
[opheldu,rd_copper_ore_powder] @rd_powder_use(rd_copper_ore_powder, last_useitem);
