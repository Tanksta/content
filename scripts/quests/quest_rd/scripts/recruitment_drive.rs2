[proc,rd_room6_take](namedobj $item, string $message)(boolean)
if (inv_total(inv, $item) > 0 | inv_total(worn, $item) > 0) {
    mes("You find nothing else useful.");
    return(false);
}
if (inv_freespace(inv) = 0) {
    mes("You don't have enough inventory space.");
    return(false);
}
inv_add(inv, $item, 1);
mes($message);
return(true);

[proc,rd_room6_tools]
