%rd_water_in_tin = 1;
mes("You pour the liquid into the tin.");

[label,rd_make_tinfull]
if (inv_total(inv, rd_tin_of_crap_empty) < 1 | inv_total(inv, rd_gypsum) < 1) {
    mes("You need a tin with liquid in it and some gypsum.");
    return;
}
