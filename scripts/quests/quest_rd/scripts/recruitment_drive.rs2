    mes("You need more inventory space to take the useful tools.");
    return;
}
if (inv_total(inv, rd_metal_spade) = 0) { inv_add(inv, rd_metal_spade, 1); }
if (inv_total(inv, rd_tin) = 0) { inv_add(inv, rd_tin, 1); }
if (inv_total(inv, rd_chisel) = 0) { inv_add(inv, rd_chisel, 1); }
if (inv_total(inv, rd_wire) = 0) { inv_add(inv, rd_wire, 1); }
if (inv_total(inv, rd_shears) = 0) { inv_add(inv, rd_shears, 1); }
if (inv_total(inv, rd_magnet) = 0) { inv_add(inv, rd_magnet, 1); }
if (inv_total(inv, rd_knife) = 0) { inv_add(inv, rd_knife, 1); }
mes("You gather the useful tools from the container.");

