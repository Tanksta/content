[if_button,controls:com_76]
if (%lost_tribe_quest < 7) {
    @lockemote_lost_tribe;
    return;
}
@controls_emote(human_cave_goblin_bow);

[if_button,controls:com_77]
if (%lost_tribe_quest < 7) {
    @lockemote_lost_tribe;
    return;
}
@controls_emote(human_cave_goblin_dance);

[if_button,controls:com_78]
if (%emote_terrified = 0) {
    @lockemote_halloween_event;
    return;
}
@controls_emote(terrified_emote);

[label,controls_emote](seq $anim)
if_close;
if (p_finduid(uid) = false) {
    // mes("You're already doing an emote!");
    return;
}
if (~inzone_coord_pair_table(trawler_wreck_zones, coord) = true) {
    mes("You cannot perform that emote whilst swimming."); // osrs
    return;
}
p_stopaction;
anim($anim, 20);
// p_delay(~seqlength20ms($anim));
~misc_quest_handle_emote($anim); // For throne of miscellania quest

[label,lockemote_mime_event]
if (p_finduid(uid) = true) {
    ~mesbox("You can't use that emote yet.");
}

[label,lockemote_lost_tribe]
if (p_finduid(uid) = true) {
    ~mesbox("You can't use that emote yet.");
}

[label,lockemote_halloween_event]
if (p_finduid(uid) = true) {
    ~mesbox("You can't use that emote yet.");
}
