[oploc1,fat_cow] @milk_cow_direct;
[oplocu,fat_cow]
switch_obj(last_useitem) {
    case bucket_empty : @milk_cow;
    case default : mes("The cow doesn't want that."); // osrs
}

[label,milk_cow_direct]
if (inv_total(inv, bucket_empty) < 1) {
    mes("You will need a empty bucket to do this.");
    return;
}
@milk_cow;

[label,milk_cow]
anim(milkit, 0);
sound_synth(milk_cow, 0, 0);
inv_del(inv, bucket_empty, 1);
inv_add(inv, bucket_milk, 1);
mes("You milk the cow."); // osrs and rsc
