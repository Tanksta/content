[proc,open_reverse_double_doors_left](int $duration, category $category, synth $sound)
def_coord $opposite = ~movecoord_loc_return(~door_close(loc_angle, loc_shape));
if ($sound ! null) {
    sound_synth($sound, 0, 0);
}
loc_del($duration);
loc_add(~movecoord_loc_return(0, 0), loc_param(next_loc_stage), calc((loc_angle + 3) % 4), wall_straight, $duration);
loc_findallzone($opposite);
while (loc_findnext = true) {
    if (loc_coord = $opposite & loc_category = $category) {
        loc_del($duration);
        loc_add(~movecoord_loc_return(0, 0), loc_param(next_loc_stage), calc((loc_angle + 1) % 4), wall_straight, $duration);
        return;
    }
}

