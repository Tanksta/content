[oploc1,_door_left_closed]
~open_double_doors_left(500, door_right_closed, loc_param(open_sound));

[oploc1,_door_right_closed]
~open_double_doors_right(500, door_left_closed, loc_param(open_sound));

[oploc1,_door_left_opened]
~close_double_doors_left(500, door_right_opened, loc_param(close_sound));

[oploc1,_door_right_opened] 
~close_double_doors_right(500, door_left_opened, loc_param(close_sound));

[oploc1,_reverse_door_left_closed]
~open_reverse_double_doors_left(500, reverse_door_right_closed, loc_param(open_sound));

[oploc1,_reverse_door_right_closed]
~open_reverse_double_doors_right(500, reverse_door_left_closed, loc_param(open_sound));

[oploc1,_reverse_door_left_opened]
~close_reverse_double_doors_left(500, reverse_door_right_opened, loc_param(close_sound));

[oploc1,_reverse_door_right_opened] 
~close_reverse_double_doors_right(500, reverse_door_left_opened, loc_param(close_sound));

// for members
[oploc1,membergatel]
if (map_members = ^false) {
    mes(^mes_members_gate);
    return;
}
~open_double_doors_left(500, door_right_closed, loc_param(open_sound));

[oploc1,membergater]
if (map_members = ^false) {
    mes(^mes_members_gate);
    return;
}
~open_double_doors_right(500, door_left_closed, loc_param(open_sound));

[proc,open_double_doors_left](int $duration, category $category, synth $sound)
def_coord $loc_coord = loc_coord;
def_int $angle = loc_angle;
def_locshape $shape = loc_shape;
def_loc $next_loc = loc_param(next_loc_stage);
def_coord $opposite = ~movecoord_loc_return(~door_close($angle, $shape));
loc_findallzone($opposite);
while (.loc_findnext = true) {
    if (.loc_coord = $opposite & .loc_category = $category) {
        def_loc $opposite_loc = .loc_type;
        if ($sound ! null) {
            sound_synth($sound, 0, 0);
        }
        loc_del($duration);
        ~door_open_leaf_opposite($loc_coord, $angle, $shape, $next_loc, $duration);
        if (loc_find($opposite, $opposite_loc) = true) {
            $loc_coord = loc_coord;
            $angle = loc_angle;
            $shape = loc_shape;
            $next_loc = loc_param(next_loc_stage);
            loc_del($duration);
            ~door_open_leaf($loc_coord, $angle, $shape, $next_loc, $duration);
        }
        return;
    }
}
if ($sound ! null) {
    sound_synth($sound, 0, 0);
}
loc_del($duration);
~door_open_leaf_opposite($loc_coord, $angle, $shape, $next_loc, $duration);

[proc,open_double_doors_right](int $duration, category $category, synth $sound)
def_coord $loc_coord = loc_coord;
def_int $angle = loc_angle;
def_locshape $shape = loc_shape;
def_loc $next_loc = loc_param(next_loc_stage);
def_coord $opposite = ~movecoord_loc_return(~multiply2(~door_close($angle, $shape), -1));
loc_findallzone($opposite);
while (.loc_findnext = true) {
    if (.loc_coord = $opposite & .loc_category = $category) {
        def_loc $opposite_loc = .loc_type;
        if ($sound ! null) {
            sound_synth($sound, 0, 0);
        }
        loc_del($duration);
        ~door_open_leaf($loc_coord, $angle, $shape, $next_loc, $duration);
        if (loc_find($opposite, $opposite_loc) = true) {
            $loc_coord = loc_coord;
            $angle = loc_angle;
            $shape = loc_shape;
            $next_loc = loc_param(next_loc_stage);
            loc_del($duration);
            ~door_open_leaf_opposite($loc_coord, $angle, $shape, $next_loc, $duration);
        }
        return;
    }
}
if ($sound ! null) {
    sound_synth($sound, 0, 0);
}
loc_del($duration);
~door_open_leaf($loc_coord, $angle, $shape, $next_loc, $duration);

[proc,open_double_doors_left2](int $duration, category $category, loc $next_loc, loc $opposite_next_loc, synth $sound)
def_coord $loc_coord = loc_coord;
def_int $angle = loc_angle;
def_locshape $shape = loc_shape;
def_coord $opposite = ~movecoord_loc_return(~door_close($angle, $shape));
if ($sound ! null) {
    sound_synth($sound, 0, 0);
}
loc_del($duration);
loc_add($loc_coord, inviswall, $angle, $shape, 3);
~door_open_leaf_opposite($loc_coord, $angle, $shape, $next_loc, $duration);
loc_findallzone($opposite);
while (loc_findnext = true) {
    if (loc_coord = $opposite & loc_category = $category) {
        $loc_coord = loc_coord;
        $angle = loc_angle;
        $shape = loc_shape;
        loc_del($duration);
        loc_add($loc_coord, inviswall, $angle, $shape, 3);
        ~door_open_leaf($loc_coord, $angle, $shape, $opposite_next_loc, $duration);
        return;
    }
}

