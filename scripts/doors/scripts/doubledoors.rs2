[proc,close_double_doors_left](int $duration, category $category, synth $sound)
def_coord $loc_coord = loc_coord;
def_int $angle = loc_angle;
def_locshape $shape = loc_shape;
def_loc $next_loc = loc_param(next_loc_stage);
def_coord $opposite = ~movecoord_loc_return(~multiply2(~door_open($angle, $shape), -1));
loc_findallzone($opposite);
while (.loc_findnext = true) {
    if (.loc_coord = $opposite & .loc_category = $category) {
        def_loc $opposite_loc = .loc_type;
        if ($sound ! null) {
            sound_synth($sound, 0, 0);
        }
        loc_del($duration);
        ~door_close_leaf_opposite($loc_coord, $angle, $shape, $next_loc, $duration);
        if (loc_find($opposite, $opposite_loc) = true) {
            $loc_coord = loc_coord;
            $angle = loc_angle;
            $shape = loc_shape;
            $next_loc = loc_param(next_loc_stage);
            loc_del($duration);
            ~door_close_leaf($loc_coord, $angle, $shape, $next_loc, $duration);
        }
        return;
    }
}
if ($sound ! null) {
    sound_synth($sound, 0, 0);
}
loc_del($duration);
~door_close_leaf_opposite($loc_coord, $angle, $shape, $next_loc, $duration);

