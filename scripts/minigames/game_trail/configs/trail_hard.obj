2dzoom=1010
2dyan=672
2dxan=360
iop1=Read
name=Clue scroll
weight=20g
category=trail_clue_hard
param=trail_desc,I lie lonely and forgotten|in mid wilderness,|where the dead rise from their beds.|Feel free to quarrel and wind me up,|and dig while you shoot their heads.
