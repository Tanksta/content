[label,diango_marionette_emote](seq $player_anim, spotanim $spotanim)
if (%action_delay > map_clock) {
    return;
}
p_stopaction;
%action_delay = add(map_clock, ~seqlength20ms($player_anim));
anim($player_anim, 20);
spotanim_pl($spotanim, 0, 0);
