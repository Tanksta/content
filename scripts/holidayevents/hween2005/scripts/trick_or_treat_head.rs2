[opheld1,trick_or_treat_head] @diango_zombie_head_talk_at;
[opheld2,trick_or_treat_head] @diango_zombie_head_display;
[opheld3,trick_or_treat_head] @diango_zombie_head_question;

[label,diango_zombie_head_talk_at]
p_stopaction;
anim(hamlet_head_all, 20);
say("Alas!");

[label,diango_zombie_head_display]
p_stopaction;
anim(scare_kid_zombie, 20);
say("Mwuhahahaha!");

[label,diango_zombie_head_question]
switch_int(~p_choice5(
    "How did you die?", 1,
    "What is your name?", 2,
    "Can you do any tricks?", 3,
    "Want a new hat?", 4,
    "Want to go scare some people?", 5
)) {
    case 1 : @diango_zombie_head_question_died;
    case 2 : @diango_zombie_head_question_name;
    case 3 : @diango_zombie_head_question_tricks;
    case 4 : @diango_zombie_head_question_hat;
    case 5 : @diango_zombie_head_question_scare;
}

[proc,diango_zombie_head_say](string $line)
~chatnpc_specific("Zombie Head", break_zomb_head, $line);

[label,diango_zombie_head_question_died]
~chatplayer("<p,neutral>Hey, Head?");
~diango_zombie_head_say("<p,neutral>What?");
~chatplayer("<p,neutral>How did you die?");
~diango_zombie_head_say("<p,neutral>I stuck my neck out for an old friend.");
~chatplayer("<p,neutral>You shouldn't get so cut up about it.");
~diango_zombie_head_say("<p,neutral>Well if I keep it all bottled up I'll turn into a total head case.");

[label,diango_zombie_head_question_name]
~chatplayer("<p,neutral>Hey, Head?");
~diango_zombie_head_say("<p,neutral>What?");
~chatplayer("<p,neutral>What is your name?");
~diango_zombie_head_say("<p,neutral>Mumblemumblemumble...");
~chatplayer("<p,neutral>What was that?");
~diango_zombie_head_say("<p,neutral>My name is Edward Cranium.");
~chatplayer("<p,neutral>Edd Cranium?");
~chatplayer("<p,happy>Hahahahahahahahahahaha!");
~diango_zombie_head_say("<p,neutral>Har har...");

[label,diango_zombie_head_question_tricks]
~chatplayer("<p,neutral>Hey Head?");
~diango_zombie_head_say("<p,neutral>What now?");
~chatplayer("<p,neutral>Can you do any tricks?");
~diango_zombie_head_say("<p,neutral>Not any more...");
~chatplayer("<p,neutral>How come?");
~diango_zombie_head_say("<p,neutral>Because I used to be able to do a handstand for over an hour while juggling cannon balls with my feet...");
~chatplayer("<p,neutral>Wow, you were quite the entertainer.");
~diango_zombie_head_say("<p,neutral>Yep. Now I can barely roll my eyes...");
~chatplayer("<p,neutral>I know what you can do!");
~diango_zombie_head_say("<p,neutral>What?");
~chatplayer("<p,neutral>Vent...");
~diango_zombie_head_say("<p,angry>Don't even suggest it!");
~chatplayer("<p,neutral>Ok.");

[label,diango_zombie_head_question_hat]
~chatplayer("<p,neutral>Hey, Head?");
~diango_zombie_head_say("<p,neutral>Can't I rest in peace?");
~chatplayer("<p,neutral>No!");
~chatplayer("<p,neutral>Would you like a new hat?");
~diango_zombie_head_say("<p,neutral>No, but could you screw a handle into the top of my head?");
~chatplayer("<p,neutral>A handle? Why?");
~diango_zombie_head_say("<p,neutral>Because currently you wave me about by my hair, and it hurts!");

[label,diango_zombie_head_question_scare]
~chatplayer("<p,neutral>Hey, Head?");
~diango_zombie_head_say("<p,neutral>Will you ever leave me alone?");
~chatplayer("<p,neutral>No!");
~chatplayer("<p,neutral>Want to go scare some people?");
~diango_zombie_head_say("<p,neutral>Let's leave it for now.");
~chatplayer("<p,neutral>All right...");
~chatplayer("<p,neutral>We'll quit while we're ahead!");
~diango_zombie_head_say("<p,neutral>If I try really hard I might be able to will myself deader...");
