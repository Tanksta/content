[opnpc1,seed_merchant]
if (~seed_merchant_check_thief = true) {
    return;
}
~chatnpc("<p,neutral>Would you like to trade in seeds?");
def_int $choice = ~p_choice3("Yes", 1, "No", 2, "Where do I get rarer seeds from?", 3);
if ($choice = 1) {
    ~openshop_activenpc;
    return;
}
if ($choice = 2) {
    ~chatplayer("<p,neutral>No, thanks.");
    return;
}
~chatplayer("<p,neutral>Where do I get rarer seeds from?");
~chatnpc("<p,neutral>The Master Farmers usually carry a few rare seeds|around with them, although I don't know if they'd want|to part with them for any price to be honest.");

[opnpc3,seed_merchant]
if (~seed_merchant_check_thief = true) {
    return;
}
~openshop_activenpc;

[proc,seed_merchant_check_thief]()(boolean)
if (getqueue(stolen_from_master_farmer) > 0) {
    npc_say("You're the one who's been pickpocketing the farmers! Guards, guards!");
    ~seed_merchant_alert_guards;
    return(true);
}
if (getqueue(stolen_from_stall_seed) > 0) {
    npc_say("You're the one who stole something from me!");
    p_delay(1);
    npc_say("Guards, guards!");
    ~seed_merchant_alert_guards;
    return(true);
}
return(false);

[proc,seed_merchant_alert_guards]
npc_huntall(npc_coord, 5, 0);
while (npc_findnext = true) {
    if ((npc_type = farming_market_guard | npc_type = wom_marketguard | npc_param(market_guard) = ^true)
        & npc_getmode ! opplayer2 & lineofsight(npc_coord, coord) = true) {
        ~npc_retaliate(0);
    }
}
