[opnpc1,lumbridge_guide2_man] @lumbridge_guide2_talk;
[opnpc1,lumbridge_guide2_woman] @lumbridge_guide2_talk;

[label,lumbridge_guide2_talk]
~chatnpc("<p,happy>Hello there, can I help you?");
switch_int(random(5)) {
    case 0 : @lumbridge_guide2_menu1;
    case 1 : @lumbridge_guide2_menu2;
    case 2 : @lumbridge_guide2_menu3;
    case 3 : @lumbridge_guide2_menu4;
    case 4 : @lumbridge_guide2_menu5;
}

[label,lumbridge_guide2_menu1]
switch_int(~p_choice4("Where am I?", 1, "How are you today?", 2, "Are there any quests I can do here?", 3, "Where can I get a haircut like yours?", 4)) {
    case 1 : @lumbridge_guide2_where_am_i;
    case 2 : @lumbridge_guide2_how_are_you;
    case 3 : @lumbridge_guide2_quests;
    case 4 : @lumbridge_guide2_haircut;
}

[label,lumbridge_guide2_menu2]
switch_int(~p_choice3("What's up?", 1, "Are there any quests I can do here?", 2, "Can I buy your stick?", 3)) {
    case 1 : @lumbridge_guide2_whats_up;
    case 2 : @lumbridge_guide2_quests;
    case 3 : @lumbridge_guide2_stick;
}

[label,lumbridge_guide2_menu3]
switch_int(~p_choice3("Do you have anything of value which I can have?", 1, "Are there any quests I can do here?", 2, "Can I buy your stick?", 3)) {
    case 1 : @lumbridge_guide2_free_stuff;
    case 2 : @lumbridge_guide2_quests;
    case 3 : @lumbridge_guide2_stick;
}

[label,lumbridge_guide2_menu4]
switch_int(~p_choice4("Where am I?", 1, "How are you today?", 2, "Are there any quests I can do here?", 3, "Your shoe lace is untied.", 4)) {
    case 1 : @lumbridge_guide2_where_am_i;
    case 2 : @lumbridge_guide2_how_are_you;
    case 3 : @lumbridge_guide2_quests;
    case 4 : @lumbridge_guide2_shoe_lace;
}

[label,lumbridge_guide2_menu5]
switch_int(~p_choice5("Where am I?", 1, "How are you today?", 2, "Are there any quests I can do here?", 3, "Your shoe lace is untied.", 4, "Do you know what happened in the castle cellar?", 5)) {
    case 1 : @lumbridge_guide2_where_am_i;
    case 2 : @lumbridge_guide2_how_are_you;
    case 3 : @lumbridge_guide2_quests;
    case 4 : @lumbridge_guide2_shoe_lace;
    case 5 : @lumbridge_guide2_cellar;
}

[label,lumbridge_guide2_where_am_i]
~chatplayer("<p,quiz>Where am I?");
~chatnpc("<p,neutral>This is the town of Lumbridge my friend.");
switch_int(~p_choice3("How are you today?", 1, "Do you know of any quests I can do?", 2, "Your shoe lace is untied.", 3)) {
    case 1 : @lumbridge_guide2_how_are_you;
    case 2 : @lumbridge_guide2_quests;
    case 3 : @lumbridge_guide2_shoe_lace;
}

[label,lumbridge_guide2_how_are_you]
~chatplayer("<p,quiz>How are you today?");
~chatnpc("<p,happy>Aye, not too bad thank you. Lovely weather in Gielinor this fine day.");
~chatplayer("<p,quiz>Weather?");
~chatnpc("<p,neutral>Yes weather, you know.");
~chatnpc("<p,neutral>The state or condition of the atmosphere at a time and place, with respect to variables such as temperature, moisture, wind velocity, and barometric pressure.");
~chatplayer("<p,neutral>...");
~chatnpc("<p,happy>Not just a pretty face eh? Ha ha ha.");

[label,lumbridge_guide2_whats_up]
~chatplayer("<p,quiz>What's up?");
~chatnpc("<p,neutral>I assume the sky is up..");
~chatplayer("<p,quiz>You assume?");
~chatnpc("<p,neutral>Yeah, unfortunately I don't seem to be able to look up.");

[label,lumbridge_guide2_free_stuff]
~chatplayer("<p,quiz>Do you have anything of value which I can have?");
~chatnpc("<p,quiz>Are you asking for free stuff?");
~chatplayer("<p,neutral>Well... er... yes.");
~chatnpc("<p,neutral>No I do not have anything I can give you. If I did have anything of value I wouldn't want to give it away.");

[label,lumbridge_guide2_stick]
~chatplayer("<p,quiz>Can I buy your stick?");
~chatnpc("<p,angry>It's not a stick! I'll have you know it's a very powerful staff!");
~chatplayer("<p,quiz>Really? Show me what it can do!");
~chatnpc("<p,sad>Um..It's a bit low on power at the moment..");
~chatplayer("<p,quiz>It's a stick isn't it?");
~chatnpc("<p,neutral>...Ok it's a stick.. But only while I save up for a staff. Zaff in Varrock square sells them in his shop.");
~chatplayer("<p,happy>Well good luck with that.");

[label,lumbridge_guide2_shoe_lace]
~chatplayer("<p,neutral>Your shoe lace is untied.");
~chatnpc("<p,angry>No it's not!");
~chatplayer("<p,neutral>No you're right. I have nothing to back that up.");
~chatnpc("<p,angry>Fool! Leave me alone!");

[label,lumbridge_guide2_haircut]
~chatplayer("<p,quiz>Where can I get a haircut like yours?");
~chatnpc("<p,neutral>Yes, it does look like you need a hairdresser.");
~chatplayer("<p,happy>Oh thanks!");
~chatnpc("<p,neutral>No problem. The hairdresser in Falador will probably be able to sort you out.");
~chatnpc("<p,neutral>The Lumbridge general store sells useful maps if you don't know the way.");

[label,lumbridge_guide2_cellar]
~chatplayer("<p,quiz>Do you know what happened in the castle cellar?");
~chatnpc("<p,neutral>I heard the wall collapsed or something. I don't know why. Perhaps you could get to the bottom of this mystery!");

[label,lumbridge_guide2_quests]
~chatplayer("<p,quiz>Do you know of any quests I can do?");
~chatnpc("<p,quiz>What kind of quest are you looking for?");
switch_int(~p_choice5("I fancy a bit of a fight, anything dangerous?", 1, "Something easy please, I'm new here.", 2, "I'm a thinker rather than fighter, anything skill oriented?", 3, "I want to do all kinds of things, do you know of anything like that?", 4, "Maybe another time.", 5)) {
    case 1 : @lumbridge_guide2_dangerous_quests;
    case 2 : @lumbridge_guide2_easy_quests;
    case 3 : @lumbridge_guide2_skill_quests;
    case 4 : @lumbridge_guide2_mixed_quests;
    case 5 : @lumbridge_guide2_maybe_another_time;
}

[label,lumbridge_guide2_maybe_another_time]
~chatplayer("<p,neutral>Maybe another time.");

[label,lumbridge_guide2_dangerous_quests]
~chatplayer("<p,neutral>I fancy a bit of a fight, anything dangerous?");
~chatnpc("<p,quiz>Hmm.. dangerous you say? What sort of creatures are you looking to fight?");
switch_int(~p_choice4("Big scary demons!", 1, "Vampyres!", 2, "Small.. something small would be good.", 3, "Maybe another time.", 4)) {
    case 1 : @lumbridge_guide2_demons;
    case 2 : @lumbridge_guide2_vampyres;
    case 3 : @lumbridge_guide2_imps;
    case 4 : @lumbridge_guide2_maybe_another_time;
}

[label,lumbridge_guide2_demons]
~chatplayer("<p,neutral>Big scary demons!");
~chatnpc("<p,neutral>You are a brave soul indeed.");
~chatnpc("<p,neutral>Now that you mention it, I heard a rumour about a fortune-teller in Varrock who is rambling about some kind of greater evil.. sounds demon-like if you ask me.");
~chatnpc("<p,neutral>Perhaps you could check it out if you are as brave as you say?");
if (%demonstart = ^demon_complete) {
    ~chatplayer("<p,happy>I've already killed the demon Delrith. He was merely a stain on my sword when I was finished with him!");
    ~chatnpc("<p,happy>Well done! However I'm sure if you search around the world you will find more challenging foes to slay.");
} else {
    ~chatplayer("<p,happy>Thanks for the tip, perhaps I will.");
}

[label,lumbridge_guide2_vampyres]
~chatplayer("<p,neutral>Vampyres!");
~chatnpc("<p,happy>Ha ha. I personally don't believe in such things. However, there is a man in Draynor Village who has been scaring the village folk with stories of vampyres.");
~chatnpc("<p,neutral>He's named Morgan and can be found in one of the village houses. Perhaps you could see what the matter is?");
if (%vampire = ^vampire_complete) {
    ~chatplayer("<p,happy>Oh I have already killed that nasty blood-sucking vampyre. Draynor will be safe now.");
    ~chatnpc("<p,neutral>Yeah, yeah of course you did. Everyone knows vampyres are not real....");
    ~chatplayer("<p,angry>What! I did slay the beast..I really did.");
    ~chatnpc("<p,neutral>You're not fooling anyone you know.");
    ~chatplayer("<p,sad>..Huh.. But... Hey! I did... believe what you like.");
} else {
    ~chatplayer("<p,happy>Thanks for the tip.");
}

[label,lumbridge_guide2_imps]
~chatplayer("<p,neutral>Small.. something small would be good.");
~chatnpc("<p,quiz>Small? Small isn't really that dangerous though is it?");
~chatplayer("<p,neutral>Yes it can be! There could be anything from an evil chicken to a poisonous spider. They attack in numbers you know!");
~chatnpc("<p,neutral>Yes ok, point taken. Speaking of small monsters, I hear old Wizard Mizgog in the wizards' tower has just had all his beads taken by a gang of mischievous imps.");
~chatnpc("<p,quiz>Sounds like it could be a quest for you?");
if (%imp = ^imp_complete) {
    ~chatplayer("<p,neutral>Yes I know of Mizgog and have already helped him with his imp problem. It took me ages to find those beads!");
    ~chatnpc("<p,happy>Imps will be imps!");
} else {
    ~chatplayer("<p,happy>Thanks for your help.");
}

[label,lumbridge_guide2_easy_quests]
~chatplayer("<p,neutral>Something easy please, I'm new here.");
~chatnpc("<p,neutral>I can tell you about plenty of small easy tasks.");
~chatnpc("<p,neutral>The Lumbridge cook has been having problems, the Duke is confused over some strange talisman and on top of all that, poor lad Romeo in Varrock has girlfriend problems.");
switch_int(~p_choice4_header("The Lumbridge cook.", 1, "The Duke's strange talisman.", 2, "Romeo and his girlfriend.", 3, "Maybe another time.", 4, "Tell me about..")) {
    case 1 : @lumbridge_guide2_cook;
    case 2 : @lumbridge_guide2_rune_mysteries;
    case 3 : @lumbridge_guide2_romeo;
    case 4 : @lumbridge_guide2_maybe_another_time;
}

[label,lumbridge_guide2_cook]
~chatplayer("<p,quiz>Tell me about the Lumbridge cook.");
~chatnpc("<p,neutral>It's funny really, the cook would forget his head if it wasn't screwed on. This time he forgot to get ingredients for the Duke's birthday cake.");
~chatnpc("<p,neutral>Perhaps you could help him? You will probably find him in the Lumbridge Castle kitchen.");
if (%cookquest = ^cook_complete) {
    ~chatplayer("<p,neutral>I have already helped the cook in Lumbridge.");
    ~chatnpc("<p,happy>Oh yes, so you have. I am sure the Duke will be pleased.");
} else {
    ~chatplayer("<p,happy>Thank you. I shall go speak with him.");
}

[label,lumbridge_guide2_rune_mysteries]
~chatplayer("<p,quiz>Tell me about the Duke's strange talisman.");
~chatnpc("<p,neutral>Well the Duke of Lumbridge has found a strange talisman that no one seems to understand. Perhaps you could help him? You can probably find him upstairs in Lumbridge Castle.");
if (%runemysteries = ^runemysteries_complete) {
    ~chatplayer("<p,neutral>Yes, I have already solved the Rune mysteries.");
    ~chatnpc("<p,happy>Ah excellent. Thank you very much adventurer.");
} else {
    ~chatplayer("<p,happy>Sounds mysterious. I may just do that. Thanks.");
}

[label,lumbridge_guide2_romeo]
~chatplayer("<p,quiz>Tell me about Romeo and his girlfriend please.");
~chatnpc("<p,neutral>Romeo in Varrock needs help with finding his beloved Juliet, you may be able to help him out.");
~chatnpc("<p,neutral>Unless of course you manage to find Juliet first in which case she has probably lost Romeo.");
if (%rjquest = ^romeojuliet_complete) {
    ~chatplayer("<p,neutral>Oh yes, I've already helped Romeo in the best possible way I can...");
    ~chatnpc("<p,quiz>Really?");
    ~chatplayer("<p,neutral>Yup.");
    ~chatnpc("<p,quiz>...How?");
    ~chatplayer("<p,neutral>He thinks Juliet is dead...");
    ~chatnpc("<p,neutral>Well.. ok.. well done... I think...");
} else {
    ~chatplayer("<p,quiz>Right, ok. Romeo is in Varrock?");
    ~chatnpc("<p,neutral>Yes you can't miss him, he's wandering aimlessly in the square.");
}

[label,lumbridge_guide2_skill_quests]
~chatplayer("<p,neutral>I'm a thinker rather than fighter, anything skill orientated?");
~chatnpc("<p,neutral>Skills play a big part when you want to progress in knowledge throughout Gielinor. I know of a few skill- related quests that can get you started.");
~chatnpc("<p,neutral>You may be able to help out Fred the farmer who is in need of someones crafting expertise.");
~chatnpc("<p,neutral>Or, there's always Doric the dwarf who needs an errand running for him?");
switch_int(~p_choice3_header("Fred the farmer.", 1, "Doric the dwarf.", 2, "Maybe another time.", 3, "Tell me about..")) {
    case 1 : @lumbridge_guide2_fred;
    case 2 : @lumbridge_guide2_doric;
    case 3 : @lumbridge_guide2_maybe_another_time;
}

[label,lumbridge_guide2_fred]
~chatplayer("<p,quiz>Tell me about Fred the farmer please.");
~chatnpc("<p,neutral>You can find Fred next to the field of sheep in Lumbridge. Perhaps you should go and speak with him.");
if (%sheep = ^sheep_complete) {
    ~chatplayer("<p,neutral>I have already helped Fred the farmer. I sheared his sheep and made 20 balls of wool for him.");
    ~chatplayer("<p,neutral>He wouldn't let me kill his chickens though.");
    ~chatnpc("<p,happy>Lumbridge chickens do make good target practice.");
    ~chatnpc("<p,neutral>You will have to wait until he isn't looking.");
} else {
    ~chatplayer("<p,happy>Thanks, maybe I will.");
}

[label,lumbridge_guide2_doric]
~chatplayer("<p,quiz>Tell me about Doric the dwarf.");
~chatnpc("<p,neutral>Doric the dwarf is located north of Falador. He might be able to help you with smithing. You should speak to him. He may let you use his anvils.");
if (%doricquest = ^doric_complete) {
    ~chatplayer("<p,neutral>Yes, I've been to see Doric already. He was happy to let me use his anvils after I ran a small errand for him.");
    ~chatnpc("<p,happy>Oh good, Thank you <displayname()>!");
} else {
    ~chatplayer("<p,happy>Thanks for the tip.");
}

[label,lumbridge_guide2_mixed_quests]
~chatplayer("<p,neutral>I want to do all kinds of things, do you know of anything like that?");
~chatnpc("<p,neutral>Of course I do. Gielinor is a huge place you know, now let me think...");
~chatnpc("<p,neutral>Hetty the witch in Rimmington might be able to offer help in the ways of magical abilities..");
~chatnpc("<p,neutral>Also, pirates are currently docked in Port Sarim, Where pirates are, treasure is never far away...");
~chatnpc("<p,neutral>Or you could go help out Ernest who got lost in Draynor Manor, spooky place that.");
switch_int(~p_choice4_header("Hetty the Witch.", 1, "Pirate's treasure.", 2, "Ernest and Draynor Manor.", 3, "Maybe another time.", 4, "Tell me about..")) {
    case 1 : @lumbridge_guide2_hetty;
    case 2 : @lumbridge_guide2_pirate;
    case 3 : @lumbridge_guide2_ernest;
    case 4 : @lumbridge_guide2_maybe_another_time;
}

[label,lumbridge_guide2_hetty]
~chatplayer("<p,quiz>Tell me about Hetty the witch.");
~chatnpc("<p,neutral>Hetty the witch can be found in Rimmington, south of Falador. She's currently working on some new potions. Perhaps you could give her a hand? She might be able to offer help with your magical abilities.");
if (%hetty = ^hetty_complete) {
    ~chatplayer("<p,neutral>Yes, I have already been to see Hetty, she gave me super cosmic powers after I helped out with her potion! I could probably destroy you with a single thought!");
    ~chatnpc("<p,quiz>Did she really?");
    ~chatplayer("<p,neutral>No not really...");
    ~chatnpc("<p,neutral>Right.....");
} else {
    ~chatplayer("<p,happy>Ok thanks, let's hope she doesn't turn me into a potato or something..");
}

[label,lumbridge_guide2_pirate]
~chatplayer("<p,quiz>Tell me about Pirate's Treasure.");
~chatnpc("<p,neutral>RedBeard Frank in Port Sarim's bar, the Rusty Anchor, might be able to tell you about the rumored treasure that is buried somewhere in Gielinor.");
if (%hunt = ^hunt_complete) {
    ~chatplayer("<p,happy>Yarr! I already found the booty!");
    ~chatnpc("<p,happy>Yarr indeed my friend. A most excellent find.");
    ~chatplayer("<p,happy>Yarr!");
    ~chatnpc("<p,happy>Yarrr!");
    ~chatplayer("<p,happy>YARRR!");
    ~chatnpc("<p,angry>Right, that's enough of that!");
    ~chatplayer("<p,sad>..Sorry.");
} else {
    ~chatplayer("<p,happy>Sounds adventurous, I may have to check that out. Thank you.");
}

[label,lumbridge_guide2_ernest]
~chatplayer("<p,quiz>Tell me about Ernest please.");
~chatnpc("<p,neutral>The best place to start would be at the gate to Draynor Manor. There you will find Veronica who will be able to tell you more.");
~chatnpc("<p,neutral>I suggest you tread carefully in that place; it's haunted.");
if (%haunted = ^haunted_complete) {
    ~chatplayer("<p,neutral>Yeah, I found Ernest already. Professor Oddenstein had turned him into a chicken!");
    ~chatnpc("<p,shock>A chicken!?");
    ~chatplayer("<p,neutral>Yeah a chicken. It could have been worse though.");
    ~chatnpc("<p,neutral>Very true, poor guy.");
} else {
    ~chatplayer("<p,happy>Sounds like fun. I've never been to a Haunted Manor before.");
}
