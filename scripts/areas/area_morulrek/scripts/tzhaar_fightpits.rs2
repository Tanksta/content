[opnpc1,tzhaar_fightpit_master]
def_int $choice = ~p_choice2_header("Enter the Fight Pits.", 1, "Not right now.", 2, "TzHaar-Mej-Kah watches.");
if_close;
if ($choice = 1) {
    ~tzhaar_fightpit_enter;
    return;
}
mes("You decide not to enter the Fight Pits yet.");

[oploc1,loc_9391]
~tzhaar_fightpit_view;

[oploc1,loc_9367]
if (~tzhaar_in_fightpit(coord) = true) {
    ~tzhaar_fightpit_leave;
} else {
    ~tzhaar_fightpit_enter;
}

[oploc1,loc_9368]
if (~tzhaar_in_fightpit(coord) = true) {
    ~tzhaar_fightpit_leave;
} else {
    ~tzhaar_fightpit_enter;
}

[oploc1,loc_9369]
if (~tzhaar_in_fightpit(coord) = true) {
    ~tzhaar_fightpit_leave;
} else {
    ~tzhaar_fightpit_enter;
}

[proc,tzhaar_fightpit_door_south]
if (coordz(coord) < coordz(loc_coord)) {
    if (~tzhaar_in_fightpit_arena(coord) = true) {
        ~tzhaar_fightpit_leave;
        return;
    }
    mes("You can only use that hot vent from inside the arena.");
    return;
}
mes("The vent only opens from inside the arena.");

[proc,tzhaar_fightpit_view]
if (~tzhaar_fightpit_phase < 2) {
    mes("There is no game currently in Fight-Pits!");
    return;
}
if_close;
if_openmain(fight_pits_vieworb);
~tzhaar_fightpit_orb_view(1);
walktrigger(tzhaar_fightpit_orb_walk);

[if_button,fight_pits_vieworb:component_04463] ~tzhaar_fightpit_stop_view;
[if_button,fight_pits_vieworb:component_15239] ~tzhaar_fightpit_orb_view(1);
[if_button,fight_pits_vieworb:component_15240] ~tzhaar_fightpit_orb_view(2);
[if_button,fight_pits_vieworb:component_15241] ~tzhaar_fightpit_orb_view(3);
[if_button,fight_pits_vieworb:component_15242] ~tzhaar_fightpit_orb_view(4);
[if_button,fight_pits_vieworb:component_15243] ~tzhaar_fightpit_orb_view(5);

[proc,tzhaar_fightpit_stop_view]
%tzhaar_fightpit_orb = 0;
if_close;
cam_reset;

[proc,tzhaar_fightpit_orb_view](int $view)
%tzhaar_fightpit_orb = $view;
cam_reset;
switch_int($view) {
    case 1 : ~tzhaar_fightpit_orb_camera(0_37_80_30_30, ^north_east_camera);
    case 2 : ~tzhaar_fightpit_orb_camera(0_37_80_16_37, ^north_west_camera);
    case 3 : ~tzhaar_fightpit_orb_camera(0_37_80_41_38, ^north_east_camera);
    case 4 : ~tzhaar_fightpit_orb_camera(0_37_80_43_17, ^south_east_camera);
    case 5 : ~tzhaar_fightpit_orb_camera(0_37_80_20_18, ^south_west_camera);
}

[proc,tzhaar_fightpit_orb_camera](coord $coord, int $camera_type)
switch_int($camera_type) {
    case ^north_camera :
        cam_moveto(movecoord($coord, 0, 0, 8), 1926, 0, 100);
        cam_lookat(movecoord($coord, 0, 0, 3), 1276, 0, 100);
    case ^south_camera :
        cam_moveto(movecoord($coord, 0, 0, -8), 1926, 0, 100);
        cam_lookat(movecoord($coord, 0, 0, -3), 1276, 0, 100);
    case ^east_camera :
        cam_moveto(movecoord($coord, 8, 0, 0), 1926, 0, 100);
        cam_lookat(movecoord($coord, 3, 0, 0), 1276, 0, 100);
    case ^west_camera :
        cam_moveto(movecoord($coord, -8, 0, 0), 1926, 0, 100);
        cam_lookat(movecoord($coord, -3, 0, 0), 1276, 0, 100);
    case ^north_east_camera :
        cam_moveto(movecoord($coord, 6, 0, 2), 1980, 0, 100);
        cam_lookat(movecoord($coord, 0, 0, -1), 1155, 0, 100);
    case ^north_west_camera :
        cam_moveto(movecoord($coord, -6, 0, 2), 1980, 0, 100);
        cam_lookat(movecoord($coord, 0, 0, -1), 1155, 0, 100);
    case ^south_east_camera :
        cam_moveto(movecoord($coord, 6, 0, -2), 1980, 0, 100);
        cam_lookat(movecoord($coord, 0, 0, 1), 1155, 0, 100);
    case ^south_west_camera :
        cam_moveto(movecoord($coord, -6, 0, -2), 1980, 0, 100);
        cam_lookat(movecoord($coord, 0, 0, 1), 1155, 0, 100);
}

[walktrigger,tzhaar_fightpit_orb_walk]
cam_reset;
%tzhaar_fightpit_orb = 0;

[proc,tzhaar_in_fightpit](coord $coord)(boolean)
if (inzone(0_37_80_14_14, 0_37_80_47_56, $coord) = true) {
    return(true);
}
return(false);

[proc,.tzhaar_in_fightpit](coord $coord)(boolean)
if (inzone(0_37_80_14_14, 0_37_80_47_56, $coord) = true) {
    return(true);
}
return(false);

[proc,tzhaar_in_fightpit_arena](coord $coord)(boolean)
if (inzone(0_37_80_14_14, 0_37_80_47_44, $coord) = true) {
    return(true);
}
return(false);

[proc,.tzhaar_in_fightpit_arena](coord $coord)(boolean)
if (inzone(0_37_80_14_14, 0_37_80_47_44, $coord) = true) {
    return(true);
}
return(false);

[proc,tzhaar_fightpit_phase]()(int)
if (npc_find(0_51_54_41_37, tzhaar_fightpit_master, 64, 0) = false) {
    return(0);
}
return(%npc_int);

[proc,tzhaar_fightpit_enter]
if (~tzhaar_in_fightpit(coord) = true) {
    mes("You are already in the Fight Pits.");
    return;
}
if (%macro_event > 0 & npc_finduid(%macro_event_uid) = true) {
    ~macro_event_disappear;
    ~macro_events_varps_reset;
}
%tzhaar_fightpit_remaining = 0;
mes("You step into the Fight Pits.");
p_delay(0);
p_telejump(map_findsquare(0_37_80_31_55, 0, 1, ^map_findsquare_lineofwalk));
~tzhaar_music_refresh;
queue(tzhaar_fightpit_post_enter, 0, 0);

[queue,tzhaar_fightpit_post_enter]
if (~tzhaar_in_fightpit(coord) = false) {
    return;
}
~tzhaar_fightpit_refresh_player;
~tzhaar_fightpit_try_start_round;

[proc,tzhaar_fightpit_leave]
def_boolean $was_arena = ~tzhaar_in_fightpit_arena(coord);
~headicon_del(^headicon_fightpit_skull);
%tzhaar_fightpit_remaining = 0;
set_player_op(null, 2, ^false);
if_openoverlay(null);
p_delay(0);
p_telejump(0_37_80_31_57);
~music_refresh_autoplay;
mes("You leave the Fight Pits.");
if ($was_arena = true) {
    ~tzhaar_fightpit_try_finish_round;
    return;
}
~tzhaar_fightpit_refresh_all;

[proc,tzhaar_fightpit_total_count]()(int)
return(map_playercount(0_37_80_14_14, 0_37_80_47_56));

[proc,tzhaar_fightpit_lobby_count]()(int)
return(map_playercount(0_37_80_14_45, 0_37_80_47_56));

[proc,tzhaar_fightpit_arena_count]()(int)
return(map_playercount(0_37_80_14_14, 0_37_80_47_44));

[proc,tzhaar_fightpit_round_active]()(boolean)
if (npc_find(0_51_54_41_37, tzhaar_fightpit_master, 64, 0) = false) {
    return(false);
}
if (%npc_int = 3) {
    return(true);
}
return(false);

[proc,tzhaar_fightpit_try_start_round]
if (~tzhaar_fightpit_total_count < 2) {
    return;
}
if (npc_find(0_51_54_41_37, tzhaar_fightpit_master, 64, 0) = false) {
    return;
}
if (%npc_int > 0) {
    ~tzhaar_fightpit_refresh_all;
    return;
}
%npc_int = 1;
%npc_int2 = 0;
npc_settimer(60);
~tzhaar_fightpit_message_all("A Fight Pits round will start shortly.");
~tzhaar_fightpit_refresh_all;

[proc,tzhaar_fightpit_message_all](string $message)
huntall(0_37_80_30_35, 32, 0);
while (huntnext = true) {
    if (~tzhaar_in_fightpit(coord) = true) {
        mes($message);
    }
}

[proc,tzhaar_fightpit_message_arena](string $message)
huntall(0_37_80_30_30, 28, 0);
while (huntnext = true) {
    if (~tzhaar_in_fightpit_arena(coord) = true) {
        mes($message);
    }
}

[proc,tzhaar_fightpit_move_lobby_to_arena]
huntall(0_37_80_30_51, 22, 0);
while (huntnext = true) {
    if (~tzhaar_in_fightpit(coord) = true & ~tzhaar_in_fightpit_arena(coord) = false) {
        queue(tzhaar_fightpit_move_to_arena, 0, 0);
    }
}

[queue,tzhaar_fightpit_move_to_arena]
p_stopaction;
p_telejump(~tzhaar_fightpit_random_arena_coord);
set_player_op("Attack", 2, ^false);
if_openoverlay(fight_pits);
mes("Please wait for the signal before fight.");

[proc,tzhaar_fightpit_random_arena_coord]()(coord)
switch_int(random(6)) {
    case 0 : return(map_findsquare(0_37_80_33_30, 0, 2, ^map_findsquare_lineofwalk));
    case 1 : return(map_findsquare(0_37_80_27_27, 0, 2, ^map_findsquare_lineofwalk));
    case 2 : return(map_findsquare(0_37_80_20_30, 0, 2, ^map_findsquare_lineofwalk));
    case 3 : return(map_findsquare(0_37_80_20_41, 0, 2, ^map_findsquare_lineofwalk));
    case 4 : return(map_findsquare(0_37_80_27_45, 0, 2, ^map_findsquare_lineofwalk));
}
return(map_findsquare(0_37_80_34_41, 0, 2, ^map_findsquare_lineofwalk));

[proc,tzhaar_fightpit_spawn_coord]()(coord)
return(map_findsquare(~tzhaar_fightpit_random_arena_coord, 0, 3, ^map_findsquare_lineofwalk));

[proc,tzhaar_fightpit_spawn_wave](int $wave)
huntall(0_37_80_30_30, 28, 0);
while (huntnext = true) {
    if (~tzhaar_in_fightpit_arena(coord) = true) {
        if ($wave = 1) {
            npc_add(~tzhaar_fightpit_spawn_coord, tzhaar_fightpit_swarm_1a, 500);
            %npc_aggressive_player = uid;
            npc_setmode(opplayer2);
        } else if ($wave = 2) {
            npc_add(~tzhaar_fightpit_spawn_coord, tzhaar_fightpit_swarm_2a, 500);
            %npc_aggressive_player = uid;
            npc_setmode(opplayer2);
        } else {
            npc_add(~tzhaar_fightpit_spawn_coord, tzhaar_fightpit_swarm_3a, 500);
            %npc_aggressive_player = uid;
            npc_setmode(opplayer2);
        }
    }
}

[proc,tzhaar_fightpit_damage_arena]
huntall(0_37_80_30_30, 28, 0);
while (huntnext = true) {
    if (~tzhaar_in_fightpit_arena(coord) = true) {
        queue(damage_player, 0, 1);
    }
}

[ai_timer,tzhaar_fightpit_master]
if (%npc_int = 1) {
    if (~tzhaar_fightpit_total_count < 2) {
        %npc_int = 0;
        %npc_int2 = 0;
        ~tzhaar_fightpit_refresh_all;
        npc_settimer(0);
        return;
    }
    %npc_int = 2;
    %npc_int2 = 0;
    ~tzhaar_fightpit_move_lobby_to_arena;
    ~tzhaar_fightpit_refresh_all;
    npc_settimer(60);
    return;
}
if (%npc_int = 2) {
    if (~tzhaar_fightpit_arena_count < 2) {
        ~tzhaar_fightpit_try_finish_round;
        return;
    }
    %npc_int = 3;
    %npc_int2 = 1;
    ~tzhaar_fightpit_message_arena("FIGHT!");
    ~tzhaar_fightpit_refresh_all;
    npc_settimer(60);
    return;
}
if (%npc_int = 3) {
    if (~tzhaar_fightpit_arena_count < 2) {
        ~tzhaar_fightpit_try_finish_round;
        return;
    }
    %npc_int2 = add(%npc_int2, 1);
    if (%npc_int2 = 5) {
        ~tzhaar_fightpit_spawn_wave(1);
    } else if (%npc_int2 = 6) {
        ~tzhaar_fightpit_spawn_wave(2);
    } else if (%npc_int2 = 7) {
        ~tzhaar_fightpit_spawn_wave(3);
    } else if (%npc_int2 >= 10) {
        ~tzhaar_fightpit_damage_arena;
    }
    ~tzhaar_fightpit_refresh_all;
    if (npc_find(0_51_54_41_37, tzhaar_fightpit_master, 64, 0) = true) {
        npc_settimer(60);
    }
    return;
}
npc_settimer(0);

[proc,tzhaar_fightpit_try_finish_round]
if (npc_find(0_51_54_41_37, tzhaar_fightpit_master, 64, 0) = true) {
    %npc_int = 0;
    %npc_int2 = 0;
    npc_settimer(0);
}
if (~tzhaar_fightpit_arena_count = 1) {
    huntall(0_37_80_30_30, 28, 0);
    while (huntnext = true) {
        if (~tzhaar_in_fightpit_arena(coord) = true) {
            queue(tzhaar_fightpit_win_round_queue, 0, 0);
        }
    }
    return;
}
~tzhaar_fightpit_refresh_all;
~tzhaar_fightpit_try_start_round;

[queue,tzhaar_fightpit_win_round_queue]
~tzhaar_fightpit_win_round;

[proc,tzhaar_fightpit_win_round]
~headicon_del(^headicon_skull);
~headicon_add(^headicon_fightpit_skull);
%tzhaar_fightpit_remaining = 0;
inv_add(inv, tzhaar_token, max(100, multiply(~tzhaar_fightpit_total_count, 100)));
if_settext(fight_pits:component_02805, "Current Champion: <displayname>");
mes("You are the champion of the Fight Pits!");
p_stopaction;
p_telejump(0_37_80_31_55);
set_player_op(null, 2, ^false);
if_openoverlay(fight_pits);
~tzhaar_fightpit_refresh_all;
~tzhaar_fightpit_try_start_round;

[proc,tzhaar_fightpit_refresh_all]
huntall(0_37_80_30_35, 32, 0);
while (huntnext = true) {
    queue(tzhaar_fightpit_refresh_player_queue, 0, 0);
}

[queue,tzhaar_fightpit_refresh_player_queue]
~tzhaar_fightpit_refresh_player;

[proc,tzhaar_fightpit_refresh_player]
if (~tzhaar_in_fightpit(coord) = false) {
    %tzhaar_fightpit_remaining = 0;
    set_player_op(null, 2, ^false);
    if_openoverlay(null);
    return;
}
if (~tzhaar_in_fightpit_arena(coord) = true) {
    set_player_op("Attack", 2, ^false);
    if (~tzhaar_fightpit_round_active = true) {
        %tzhaar_fightpit_remaining = max(0, sub(~tzhaar_fightpit_arena_count, 1));
    } else {
        %tzhaar_fightpit_remaining = 0;
    }
    if_openoverlay(fight_pits);
    return;
}
%tzhaar_fightpit_remaining = 0;
set_player_op(null, 2, ^false);
if_openoverlay(fight_pits);

[proc,tzhaar_fightpit_cleanup_player]
~headicon_del(^headicon_fightpit_skull);
%tzhaar_fightpit_remaining = 0;
set_player_op(null, 2, ^false);
if_openoverlay(null);

[proc,tzhaar_fightpit_is_attackable]()(boolean)
if (~tzhaar_in_fightpit_arena(coord) = true & ~.tzhaar_in_fightpit_arena(.coord) = true) {
    if (~tzhaar_fightpit_round_active = true) {
        return(true);
    }
    mes("You're not allowed to attack yet!");
}
return(false);

[proc,tzhaar_fightpit_player_death]
def_obj $prev_wep = inv_getobj(worn, ^wearpos_rhand);
def_boolean $was_arena = ~tzhaar_in_fightpit_arena(coord);
~player_death;
~music_jingle(death2);
mes("Oh dear you are dead!");
~combat_clearqueue;
clearqueue(player_death);
~tzhaar_fightpit_cleanup_player;
if_close;
p_stopaction;
if ($was_arena = true) {
    p_telejump(0_37_80_31_55);
    mes("You return to the Fight Pits waiting area.");
} else {
    p_telejump(0_37_80_31_57);
}
buildappearance(worn);
~prayer_deactivate_all;
anim(null, 0);
~stat_reset_all;
healenergy(10000);
~clear_pk_skull;
~clear_poison;
~update_all($prev_wep);
~initalltabs;
~sa_reset;
~music_refresh_autoplay;
if ($was_arena = true) {
    ~tzhaar_fightpit_try_finish_round;
}
~tzhaar_fightpit_refresh_all;

[ai_queue1,tzhaar_fightpit_swarm_1a] ~npc_default_retaliate;
[ai_queue1,tzhaar_fightpit_swarm_1b] ~npc_default_retaliate;
[ai_queue1,tzhaar_fightpit_swarm_2a] ~npc_default_retaliate;
[ai_queue1,tzhaar_fightpit_swarm_2b] ~npc_default_retaliate;
[ai_queue1,tzhaar_fightpit_swarm_3a] ~tzhaar_retaliate_ap;
[ai_queue1,tzhaar_fightpit_swarm_3b] ~tzhaar_retaliate_ap;

[ai_opplayer2,tzhaar_fightpit_swarm_1a] ~tzhaar_kih_attack;
[ai_opplayer2,tzhaar_fightpit_swarm_1b] ~tzhaar_kih_attack;
[ai_opplayer2,tzhaar_fightpit_swarm_2a] ~npc_default_attack;
[ai_opplayer2,tzhaar_fightpit_swarm_2b] ~npc_default_attack;

[ai_opplayer2,tzhaar_fightpit_swarm_3a]
if (npc_range(coord) > 1) {
    npc_setmode(applayer2);
    return;
}
gosub(npc_default_attack);

[ai_opplayer2,tzhaar_fightpit_swarm_3b]
if (npc_range(coord) > 1) {
    npc_setmode(applayer2);
    return;
}
gosub(npc_default_attack);

[ai_applayer2,tzhaar_fightpit_swarm_3a]
if (npc_range(coord) <= 1) {
    npc_setmode(opplayer2);
    return;
}
~tzhaar_spine_rangeattack;

[ai_applayer2,tzhaar_fightpit_swarm_3b]
if (npc_range(coord) <= 1) {
    npc_setmode(opplayer2);
    return;
}
~tzhaar_spine_rangeattack;

[ai_queue3,tzhaar_fightpit_swarm_1a] gosub(npc_death);
[ai_queue3,tzhaar_fightpit_swarm_1b] gosub(npc_death);
[ai_queue3,tzhaar_fightpit_swarm_2a] gosub(npc_death);
[ai_queue3,tzhaar_fightpit_swarm_2b] gosub(npc_death);
[ai_queue3,tzhaar_fightpit_swarm_3a] gosub(npc_death);
[ai_queue3,tzhaar_fightpit_swarm_3b] gosub(npc_death);
