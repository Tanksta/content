[ai_queue3,tzhaar_hur1] @tzhaar_hur_drops;
[ai_queue3,tzhaar_hur2] @tzhaar_hur_drops;
[ai_queue3,tzhaar_hur3] @tzhaar_hur_drops;
[ai_queue3,tzhaar_hur4] @tzhaar_hur_drops;
[ai_queue3,tzhaar_hur5] @tzhaar_hur_drops;
[ai_queue3,tzhaar_hur6] @tzhaar_hur_drops;

[label,tzhaar_hur_drops]
gosub(npc_death);
if (npc_findhero = ^false) {
    return;
}

def_int $random = random(2048);

if ($random < 1) {
    obj_add(npc_coord, uncut_diamond, 1, ^lootdrop_duration);
} else if ($random < 5) {
    obj_add(npc_coord, uncut_ruby, 1, ^lootdrop_duration);
} else if ($random < 13) {
    obj_add(npc_coord, uncut_emerald, 1, ^lootdrop_duration);
} else if ($random < 29) {
    obj_add(npc_coord, uncut_sapphire, 1, ^lootdrop_duration);
} else if ($random < 157) {
    obj_add(npc_coord, chisel, 1, ^lootdrop_duration);
} else if ($random < 285) {
    obj_add(npc_coord, hammer, 1, ^lootdrop_duration);
} else if ($random < 413) {
    obj_add(npc_coord, jug_empty, 1, ^lootdrop_duration);
} else if ($random < 541) {
    obj_add(npc_coord, knife, 1, ^lootdrop_duration);
} else if ($random < 669) {
    obj_add(npc_coord, pot_empty, 1, ^lootdrop_duration);
} else if ($random < 1693) {
    obj_add(npc_coord, tzhaar_token, calc(1 + random(16)), ^lootdrop_duration);
}
