}
p_arrivedelay;
facesquare(loc_coord);
anim(agility_shortcut_wall_jump, 0);
p_delay(1);
p_telejump(3_57_154_21_32);
anim(agility_shortcut_wall_jump2, 0);
p_delay(1);

