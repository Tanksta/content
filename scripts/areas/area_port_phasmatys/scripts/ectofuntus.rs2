[oplocu,ahoy_ectofunctus]
switch_obj(last_useitem) {
    case ectophial_empty :
        inv_setslot(inv, last_useslot, ectophial, 1);
        anim(ahoy_ectophial_teleport, 0);
        sound_synth(fill_ectoplasm, 0, 0);
        mes("You refill the ectophial from the Ectofuntus.");
    case default :
        ~displaymessage(^dm_default);
}

[oploc1,ahoy_ectofunctus]
if (ectofuntus_unclaimed_tokens >= ^ahoy_ectofuntus_max_unclaimed_tokens) {
    mes("There isn't room to put any more in.");
    return;
}
def_obj $bonemeal = ~ectofuntus_find_bonemeal;
if ($bonemeal = null) {
    mes("You need some bonemeal to worship the Ectofuntus.");
    return;
}
if (inv_total(inv, bucket_ectoplasm) < 1) {
    mes("You need a bucket of slime to worship the Ectofuntus.");
    return;
}
inv_del(inv, $bonemeal, 1);
inv_del(inv, bucket_ectoplasm, 1);
inv_add(inv, pot_empty, 1);
inv_add(inv, bucket_empty, 1);
anim(ahoy_prayer, 0);
sound_synth(prayer_recharge, 0, 0);
stat_advance(prayer, ~ectofuntus_bonemeal_xp($bonemeal));
ectofuntus_add_unclaimed_tokens(^ahoy_ectofuntus_tokens_per_worship);
mes("You worship the Ectofuntus.");

[opnpc1,ahoy_disciple]
if (~ahoy_has_ghostspeak = false) {
    ~chatnpc("<p,neutral>Woo woo wooo woo.");
    mes("You cannot understand the ghost.");
    return;
}
def_int $tokens = ectofuntus_unclaimed_tokens;
if ($tokens < 1) {
    def_int $info = ~p_choice3("How do I worship the Ectofuntus?", 1, "What are ecto-tokens?", 2, "Nothing, thanks.", 3);
    if ($info = 1) {
        ~chatnpc("<p,neutral>Grind bones in the bone grinder upstairs. You will|need an empty pot to catch the bonemeal.");
        ~chatnpc("<p,neutral>Then fill a bucket with slime from the pool below|the temple. Use the bonemeal and slime to worship|the Ectofuntus.");
    } else if ($info = 2) {
        ~chatnpc("<p,neutral>After you worship, speak to one of us disciples and|we shall give you five ecto-tokens for each worship.");
    }
    return;
}
~chatnpc("<p,happy>You have pleased the Ectofuntus. Accept these ecto-tokens.");
inv_add(inv, ectotoken, $tokens);
ectofuntus_clear_unclaimed_tokens;

