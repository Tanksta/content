[proc,ahoy_has_ghostspeak]()(boolean)
if (inv_total(worn, amulet_of_ghostspeak) > 0 | inv_total(worn, amulet_of_ghostspeak_enchanted) > 0) return(true);
return(false);

[opheld1,ectophial]
def_int $slot = last_slot;
if (~wilderness_level(coord) > 20) {
    mes("A mysterious force blocks your teleport spell!");
    mes("You can't use this teleport after level 20 wilderness.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}
inv_setslot(inv, $slot, ectophial_empty, 1);
anim(ahoy_ectophial_teleport, 0);
sound_synth(teleport_all, 0, 0);
obj_add(coord, ectoplasm_puddle, 1, 5);
mes("You empty the ectoplasm onto the ground around your feet...");
mes("...and the world changes around you.");
p_delay(3);
p_telejump(0_57_54_10_60);

