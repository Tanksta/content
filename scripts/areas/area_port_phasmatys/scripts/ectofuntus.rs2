[label,ectofuntus_fill_slime_use]
if (last_useitem ! bucket_empty) {
    ~displaymessage(^dm_default);
    return;
}
@ectofuntus_fill_slime;

[label,ectofuntus_fill_slime_click]
if (inv_total(inv, bucket_empty) < 1) {
    mes("You need an empty bucket to collect slime.");
    return;
}
@ectofuntus_fill_slime;

[label,ectofuntus_fill_slime]
def_int $buckets = inv_total(inv, bucket_empty);
while ($buckets > 0) {
    inv_del(inv, bucket_empty, 1);
    inv_add(inv, bucket_ectoplasm, 1);
    $buckets = sub($buckets, 1);
}
anim(human_pickuptable, 0);
mes("You fill your buckets with slime.");

[oplocu,ahoy_grinder]
@ectofuntus_use_grinder;

[label,ectofuntus_use_grinder]
if (last_useitem = pot_empty) {
    @ectofuntus_collect_bonemeal_use;
    return;
}
@ectofuntus_load_grinder;

[label,ectofuntus_load_grinder]
def_namedobj $bonemeal = ~ectofuntus_bone_to_bonemeal(last_useitem);
if ($bonemeal = null) {
    ~displaymessage(^dm_default);
    return;
}
if (ectofuntus_pending_bonemeal ! 0) {
    mes("There is already some bonemeal ready to collect.");
    return;
}
inv_delslot(inv, last_useslot);
ectofuntus_set_pending_bonemeal(~ectofuntus_bonemeal_code($bonemeal));
%ahoy_grinder_status = 1;
anim(ahoy_bone_grind, 0);
sound_synth(fill_grinder, 0, 0);
mes("You grind the bones into bonemeal.");

[oploc1,ahoy_grinder]
@ectofuntus_wind_grinder;

[label,ectofuntus_wind_grinder]
anim(ahoy_bone_grind, 0);
sound_synth(grinder_grinding, 0, 0);
mes("You turn the grinder handle.");

[oploc2,ahoy_grinder]
@ectofuntus_collect_bonemeal_click;

[label,ectofuntus_collect_bonemeal_click]
if (ectofuntus_pending_bonemeal = 0) {
    mes("There is no bonemeal to collect.");
    return;
}
if (inv_total(inv, pot_empty) < 1) {
    mes("You need an empty pot to collect the bonemeal.");
    return;
}
def_int $bonemeal = ectofuntus_pending_bonemeal;
inv_del(inv, pot_empty, 1);
inv_add(inv, ~ectofuntus_code_to_bonemeal($bonemeal), 1);
ectofuntus_set_pending_bonemeal(0);
%ahoy_grinder_status = 0;
anim(ahoy_fillbucket_bonedust, 0);
sound_synth(grinder_empty, 0, 0);
mes("You collect the bonemeal in a pot.");

[oploc3,ahoy_grinder]
@ectofuntus_grinder_status;

[label,ectofuntus_grinder_status]
if (ectofuntus_pending_bonemeal = 0) {
    mes("There is no bonemeal to collect.");
    return;
}
mes("There is some bonemeal ready to collect.");

[label,ectofuntus_collect_bonemeal_use]
if (last_useitem ! pot_empty) {
    ~displaymessage(^dm_default);
    return;
}
if (ectofuntus_pending_bonemeal = 0) {
    mes("There is no bonemeal to collect.");
    return;
}
def_int $bonemeal = ectofuntus_pending_bonemeal;
inv_delslot(inv, last_useslot);
inv_add(inv, ~ectofuntus_code_to_bonemeal($bonemeal), 1);
ectofuntus_set_pending_bonemeal(0);
%ahoy_grinder_status = 0;
anim(ahoy_fillbucket_bonedust, 0);
sound_synth(grinder_empty, 0, 0);
mes("You collect the bonemeal in a pot.");

