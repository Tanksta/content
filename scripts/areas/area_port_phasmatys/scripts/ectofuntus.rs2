inv_setslot(inv, last_slot, bucket_empty, 1);
mes("You empty the bucket of slime.");

[proc,ectofuntus_find_bonemeal]()(obj)
if (inv_total(inv, pot_bonemeal) > 0) return(pot_bonemeal);
if (inv_total(inv, pot_bonemeal_bat) > 0) return(pot_bonemeal_bat);
if (inv_total(inv, pot_bonemeal_big) > 0) return(pot_bonemeal_big);
if (inv_total(inv, pot_bonemeal_burnt) > 0) return(pot_bonemeal_burnt);
if (inv_total(inv, pot_bonemeal_babydragon) > 0) return(pot_bonemeal_babydragon);
if (inv_total(inv, pot_bonemeal_dragon) > 0) return(pot_bonemeal_dragon);
if (inv_total(inv, pot_bonemeal_wolf) > 0) return(pot_bonemeal_wolf);
if (inv_total(inv, pot_bonemeal_jogre) > 0) return(pot_bonemeal_jogre);
if (inv_total(inv, pot_bonemeal_burnt_jogre) > 0) return(pot_bonemeal_burnt_jogre);
if (inv_total(inv, pot_bonemeal_normal_monkey) > 0) return(pot_bonemeal_normal_monkey);
if (inv_total(inv, pot_bonemeal_small_ninja_monkey) > 0) return(pot_bonemeal_small_ninja_monkey);
if (inv_total(inv, pot_bonemeal_medium_ninja_monkey) > 0) return(pot_bonemeal_medium_ninja_monkey);
if (inv_total(inv, pot_bonemeal_normal_gorilla_monkey) > 0) return(pot_bonemeal_normal_gorilla_monkey);
if (inv_total(inv, pot_bonemeal_bearded_gorilla_monkey) > 0) return(pot_bonemeal_bearded_gorilla_monkey);
if (inv_total(inv, pot_bonemeal_small_zombie_monkey) > 0) return(pot_bonemeal_small_zombie_monkey);
if (inv_total(inv, pot_bonemeal_large_zombie_monkey) > 0) return(pot_bonemeal_large_zombie_monkey);
if (inv_total(inv, pot_bonemeal_skeleton) > 0) return(pot_bonemeal_skeleton);
if (inv_total(inv, pot_bonemeal_zogre) > 0) return(pot_bonemeal_zogre);
if (inv_total(inv, pot_bonemeal_ancestral_fayg) > 0) return(pot_bonemeal_ancestral_fayg);
if (inv_total(inv, pot_bonemeal_ancestral_raurg) > 0) return(pot_bonemeal_ancestral_raurg);
if (inv_total(inv, pot_bonemeal_ancestral_ourg) > 0) return(pot_bonemeal_ancestral_ourg);
if (inv_total(inv, pot_bonemeal_beast) > 0) return(pot_bonemeal_beast);
if (inv_total(inv, pot_bonemeal_dagannoth) > 0) return(pot_bonemeal_dagannoth);
if (inv_total(inv, pot_bonemeal_wyvern) > 0) return(pot_bonemeal_wyvern);
return(null);

[proc,ectofuntus_bone_to_bonemeal](obj $bones)(namedobj)
switch_obj($bones) {
    case bones :
        return(pot_bonemeal);
    case bones_burnt :
        return(pot_bonemeal_burnt);
    case bat_bones :
        return(pot_bonemeal_bat);
    case big_bones :
        return(pot_bonemeal_big);
    case babydragon_bones :
        return(pot_bonemeal_babydragon);
    case dragon_bones :
        return(pot_bonemeal_dragon);
    case wolf_bones :
        return(pot_bonemeal_wolf);
    case tbwt_jogre_bones :
        return(pot_bonemeal_jogre);
    case tbwt_burnt_jogre_bones :
        return(pot_bonemeal_burnt_jogre);
    case mm_normal_monkey_bones :
        return(pot_bonemeal_normal_monkey);
    case mm_small_ninja_monkey_bones :
        return(pot_bonemeal_small_ninja_monkey);
    case mm_medium_ninja_monkey_bones :
        return(pot_bonemeal_medium_ninja_monkey);
    case mm_normal_gorilla_monkey_bones :
        return(pot_bonemeal_normal_gorilla_monkey);
    case mm_bearded_gorilla_monkey_bones :
        return(pot_bonemeal_bearded_gorilla_monkey);
    case mm_small_zombie_monkey_bones :
        return(pot_bonemeal_small_zombie_monkey);
    case mm_large_zombie_monkey_bones :
        return(pot_bonemeal_large_zombie_monkey);
    case mm_skeleton_bones :
        return(pot_bonemeal_skeleton);
    case zogre_bones :
        return(pot_bonemeal_zogre);
    case zogre_ancestral_bones_fayg :
        return(pot_bonemeal_ancestral_fayg);
    case zogre_ancestral_bones_raurg :
        return(pot_bonemeal_ancestral_raurg);
    case zogre_ancestral_bones_ourg :
        return(pot_bonemeal_ancestral_ourg);
    case tbwt_beast_bones :
        return(pot_bonemeal_beast);
    case dagannoth_king_bones :
        return(pot_bonemeal_dagannoth);
    case wyvern_bones :
        return(pot_bonemeal_wyvern);
    case default :
        return(null);
}

[proc,ectofuntus_bonemeal_code](obj $bonemeal)(int)
switch_obj($bonemeal) {
    case pot_bonemeal : return(1);
    case pot_bonemeal_burnt : return(2);
    case pot_bonemeal_bat : return(3);
    case pot_bonemeal_big : return(4);
    case pot_bonemeal_babydragon : return(5);
    case pot_bonemeal_dragon : return(6);
    case pot_bonemeal_wolf : return(7);
    case pot_bonemeal_jogre : return(8);
    case pot_bonemeal_burnt_jogre : return(9);
    case pot_bonemeal_normal_monkey : return(10);
    case pot_bonemeal_small_ninja_monkey : return(11);
    case pot_bonemeal_medium_ninja_monkey : return(12);
    case pot_bonemeal_normal_gorilla_monkey : return(13);
    case pot_bonemeal_bearded_gorilla_monkey : return(14);
    case pot_bonemeal_small_zombie_monkey : return(15);
    case pot_bonemeal_large_zombie_monkey : return(16);
    case pot_bonemeal_skeleton : return(17);
    case pot_bonemeal_zogre : return(18);
    case pot_bonemeal_ancestral_fayg : return(19);
    case pot_bonemeal_ancestral_raurg : return(20);
    case pot_bonemeal_ancestral_ourg : return(21);
    case pot_bonemeal_beast : return(22);
    case pot_bonemeal_dagannoth : return(23);
    case pot_bonemeal_wyvern : return(24);
    case default : return(0);
}

[proc,ectofuntus_code_to_bonemeal](int $bonemeal)(namedobj)
switch_int($bonemeal) {
    case 1 : return(pot_bonemeal);
    case 2 : return(pot_bonemeal_burnt);
    case 3 : return(pot_bonemeal_bat);
    case 4 : return(pot_bonemeal_big);
    case 5 : return(pot_bonemeal_babydragon);
    case 6 : return(pot_bonemeal_dragon);
    case 7 : return(pot_bonemeal_wolf);
    case 8 : return(pot_bonemeal_jogre);
    case 9 : return(pot_bonemeal_burnt_jogre);
    case 10 : return(pot_bonemeal_normal_monkey);
    case 11 : return(pot_bonemeal_small_ninja_monkey);
    case 12 : return(pot_bonemeal_medium_ninja_monkey);
    case 13 : return(pot_bonemeal_normal_gorilla_monkey);
    case 14 : return(pot_bonemeal_bearded_gorilla_monkey);
    case 15 : return(pot_bonemeal_small_zombie_monkey);
    case 16 : return(pot_bonemeal_large_zombie_monkey);
    case 17 : return(pot_bonemeal_skeleton);
    case 18 : return(pot_bonemeal_zogre);
    case 19 : return(pot_bonemeal_ancestral_fayg);
    case 20 : return(pot_bonemeal_ancestral_raurg);
    case 21 : return(pot_bonemeal_ancestral_ourg);
    case 22 : return(pot_bonemeal_beast);
    case 23 : return(pot_bonemeal_dagannoth);
    case 24 : return(pot_bonemeal_wyvern);
    case default : return(pot_bonemeal);
}

[proc,ectofuntus_bonemeal_xp](obj $bonemeal)(int)
switch_obj($bonemeal) {
    case pot_bonemeal, pot_bonemeal_bat, pot_bonemeal_burnt, pot_bonemeal_wolf, pot_bonemeal_normal_monkey,
        pot_bonemeal_small_ninja_monkey, pot_bonemeal_medium_ninja_monkey, pot_bonemeal_small_zombie_monkey,
        pot_bonemeal_large_zombie_monkey, pot_bonemeal_skeleton :
        return(180);
    case pot_bonemeal_big, pot_bonemeal_jogre, pot_bonemeal_burnt_jogre :
        return(600);
    case pot_bonemeal_babydragon :
        return(1200);
    case pot_bonemeal_dragon :
        return(2880);
    case pot_bonemeal_beast :
        return(1000);
    case pot_bonemeal_normal_gorilla_monkey, pot_bonemeal_bearded_gorilla_monkey :
        return(600);
    case pot_bonemeal_dagannoth :
        return(500);
    case pot_bonemeal_wyvern :
        return(2880);
    case pot_bonemeal_zogre :
        return(900);
    case pot_bonemeal_ancestral_fayg :
        return(3360);
    case pot_bonemeal_ancestral_raurg :
        return(3840);
    case pot_bonemeal_ancestral_ourg :
        return(5600);
    case default :
        return(180);
}
