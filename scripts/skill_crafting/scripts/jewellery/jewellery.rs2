if(inv_total(inv, fenk_lightning_mould) > 0) {
    inv_setslot(silvercast_lightning, 0, fenk_conductor, 1);
    if_sethide(silver_crafting:com_108, false);
    if_sethide(silver_crafting:com_111, true);
} else {
