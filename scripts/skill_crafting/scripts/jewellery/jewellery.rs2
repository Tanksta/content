[label,craft_silver_product](namedobj $product, int $count)
if (~craft_silver_product_check($product) = false) {
    return;
}
def_struct $struct = oc_param($product, crafting_jewelry_struct);
def_namedobj $mould = struct_param($struct, mould);
if(inv_total(inv, $mould) = 0) {
    if_close;
    ~mesbox("You require a mould to make that.");
    return;
}

def_int $level = struct_param($struct, levelrequired);
if (stat(crafting) < $level) {
    if_close;
    ~mesbox("You need at least level <tostring($level)> Crafting to make that.");
    return;
}

// macro event
if (afk_event = ^true) {
    if_close;
    ~macro_event_general_spawn(~macro_event_set_random);
    return;
}
if_close;
@process_craft_silver($struct, $product, $count);

[proc,craft_silver_product_check](namedobj $product)(boolean)
if(map_members = ^false) {
    if($product = silver_sickle | $product = fenk_conductor | $product = agrith_sigil) {
        if_close;
        ~mesbox("You can only craft this item on a members' world.");
        return(false);
    }
}
return(true);

[label,process_craft_silver](struct $struct, namedobj $product, int $count)
anim(human_furnace, 0);
sound_synth(furnace, 1, 0);
// initial is 2t, afterwards is 3t cause processing order, not action_delay dependennt
weakqueue*(craft_silver, 2)($struct, $product, $count);

[queue,craft_silver](struct $struct, namedobj $product, int $count)
if(inv_total(inv, silver_bar) = 0) {
    // https://youtu.be/WJ2gW6dx_vo?si=Hl5EcZQoyaxqyr_P&t=121
    mes("You have run out of silver bars.");
    return;
}
inv_del(inv, silver_bar, 1);
inv_add(inv, $product, 1);
stat_advance(crafting, struct_param($struct, productexp));
// Confirmed, no period at the end. https://i.imgur.com/sCKRVO9.png
mes("You make <~add_article(struct_param($struct, name))>");
if(sub($count, 1) < 1) {
    return;
}
@process_craft_silver($struct, $product, sub($count, 1));

//******************* WEAKQUEUES NOT-USED UNTIL SEPT 2004 *******************
// //--- weakqueue to craft gold jewelry, should craft jewelry at a rate of 3 ticks.
// //    And should repeat until the specified count is reached.
// [weakqueue,crafting_gold](int $productexp, namedobj $gem, namedobj $product, int $count)
// //mes(oc_name($product));
// //mes(tostring($count));

