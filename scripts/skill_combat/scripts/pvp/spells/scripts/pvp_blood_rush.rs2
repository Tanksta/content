[opplayert,magic2:com_45] ~pvp_blood_rush(^blood_rush);
[applayert,magic2:com_45] ~pvp_blood_rush(^blood_rush);

[proc,pvp_blood_rush](int $spell)
def_dbrow $spell_data = ~get_spell_data($spell);

if (~pvp_combat_spell_checks($spell_data) = false) {
    return;
}

def_int $duration = ~pvp_spell_cast($spell_data);

if (~pvp_hit_roll(^magic_style) = true) {

    def_int $maxhit = ~magic_spell_maxhit($spell_data);

    def_int $damage = ~pvp_spell_success($spell_data, $maxhit, $duration);

    def_int $heal = divide($damage, 4);

    if ($heal > 0) {
        stat_add(hitpoints, $heal, 0);
    }

} else {
    ~pvp_spell_fail_custom($spell_data, $duration, blood_rush_fail);
}
